static inline int mp4_hud_group(const uint8_t id[16]) {
    if(!id) return -1;
    for(unsigned i=0;i<sizeof mp4_hud_groups/sizeof *mp4_hud_groups;i++)
        if(!memcmp(id,mp4_hud_groups[i].template_id,16)) return (int)i;
    return -1;
}
// A source Entity transform record: row-major rotation/translation 3x4,
// separate scale[3], duplicate translation[3], padding. Apply a camera-space
// affine map rather than simply changing FOV or shrinking about the centre.
// The original HUD camera's reference pose is (0,0,8.64441967), vertical FOV55;
// the actual HUD callback/composition packet independently confirmed that FOV.
// Authored UI x is negative on the left (ROOM radar/selector templates),
// positive on the right (compass/ammunition templates). Classify the whole
// template, never individual children's signs, so a block stays together.
// x_ndc' = s*x_ndc + side*(.9-s); y_ndc' = s*y_ndc + anchor*(1-s).
// The source 16:9 edges +/-1 map to the visible 16:10 edges +/-.9.
// Anchoring around +/-.9 directly would clip widgets: the source frame is
// wider than the crop. The .9 is (16/10)/(16/9), not a per-widget offset.
// Therefore top/bottom anchors (+/-1) stay fixed, circles scale uniformly,
// and z/w (depth) stay unchanged. Native scale and source animation data stay.
static inline int mp4_hud_matrix(float record[19],int side,int anchor,float scale) {
    if(!record || side < -1 || side > 1 || (anchor!=1 && anchor!=-1) || !isfinite(scale) || scale<=0 || scale>=1) return 0;
    for(int i=0;i<19;i++) if(!isfinite(record[i]) || fabsf(record[i])>100000) return 0;
    for(int i=0;i<3;i++) {
        if(record[12+i]<=0 || record[12+i]>10000) return 0;
        if(fabsf(record[15+i]-record[3+4*i])>.0001f) return 0;
    }
    const float camera_z=8.64441967010498f;
    if(camera_z-record[11]<=.1f || camera_z-record[11]>1000) return 0;
    const float slope=0.5205670505517462f; // tan(55 degrees / 2), independently derived
    float next[19];memcpy(next,record,sizeof next);
    float a=anchor*(1-scale)*slope;
    float h=side*(.9f-scale)*slope*(16.f/9.f);
    for(int j=0;j<4;j++) {
        next[j]=scale*record[j]-h*record[8+j]+(j==3?h*camera_z:0);
        next[4+j]=scale*record[4+j]-a*record[8+j]+(j==3?a*camera_z:0);
    }
    for(int i=0;i<3;i++) next[15+i]=next[3+4*i];
    memcpy(record,next,sizeof next);return 1;
}

// Return group+1 only after a selected visual child was changed. The native
// Entity ABI is guarded in the manifest generator; this is not a public API.
static inline int mp4_hud_apply(const void *properties, void *transform) {
    if(!properties || !transform) return 0;
    const uint8_t *p=properties;
    int group=mp4_hud_group(p+0xc);
    if(group<0) return 0;
    int count;memcpy(&count,p+0x50,4);
    if(count<1 || count>256) return 0;
    if(count==1) {
        const uint8_t *ids;memcpy(&ids,p+0x58,sizeof ids);
        if(!ids || !memcmp(ids,mp4_hud_groups[group].root_component,16)) return 0;
    }
    float record[19];memcpy(record,transform,sizeof record);
    if(!mp4_hud_matrix(record,mp4_hud_groups[group].side,mp4_hud_groups[group].anchor,.85f)) return 0;
    memcpy(transform,record,sizeof record);
    return group+1;
}

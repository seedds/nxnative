+    r.sc[0] = R.sc.x; r.sc[1] = R.sc.y; r.sc[2] = R.sc.w; r.sc[3] = R.sc.h; r.has_sc = R.has_sc;
+    { NSUInteger tw0 = 0, th0 = 0; rt_dims(&tw0, &th0); r.tw = (uint32_t)tw0; r.th = (uint32_t)th0; }   // the target this draw renders to, as rp_begin_ex will size it
+    { id<MTLTexture> ct = R.rt.n && R.rt.color[0] ? tex_mtl(R.rt.color[0]) : nil, dt = R.rt.depth ? tex_mtl(R.rt.depth) : nil;
+      r.cfmt0 = ct ? (uint32_t)ct.pixelFormat : 0; r.dfmt = dt ? (uint32_t)dt.pixelFormat : 0;
+      r.samples = ct ? (uint32_t)ct.sampleCount : 0; r.nrt = (uint32_t)R.rt.n;
+      r.cser = R.rt.color[0] ? R.rt.color[0]->serial : 0; }
+    if (pr->sh[0]) memcpy(r.vs, pr->sh[0]->key, 20);
+    if (pr->sh[1]) memcpy(r.fs, pr->sh[1]->key, 20);
+    if (pr->sh[2]) memcpy(r.gs, pr->sh[2]->key, 20);
+    r.flags = (atest_on() ? 2u : 0u) | (pr->sh[1] && pr->sh[1]->has_alpha ? 4u : 0u)
+            | (pr->sh[1] && pr->sh[1]->rf.may_discard ? 8u : 0u) | (S.rast_discard ? 16u : 0u);
+    // The lattice's own signature: a group of four vertices whose uv is the unit square and whose positions span the screen
+    if (r.stride == 28 && r.count >= 8 && (size_t)r.count * 28 <= PDX_CAP && r.vb0) {
+        static uint8_t blk[PDX_CAP] __attribute__((aligned(16)));
+        if (vb_read(r.vb0, (size_t)r.count * 28, blk)) {
+            for (int i = 0; i + 4 <= r.count; i += 4) {
+                const uint8_t *p = blk + (size_t)i * 28;
+                if (!pdx_unit_uv(p)) continue;
+                uint32_t sp = pdx_span(p, 4);
+                r.flags |= 1u; r.quadi = (uint32_t)(i / 4); r.quadspan = sp;
+                memcpy(r.qb, p, 112);   // the quad's four vertices, so what it paints (tint alpha, uv, positions) can be diffed offline

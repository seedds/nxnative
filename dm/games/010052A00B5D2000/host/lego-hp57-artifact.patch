+    if (srt_fd < 0 || !pr) return;
+    int atst = rt_atlas(pr); if (atst < 0) return;
+    srt_rec r; memset(&r, 0, sizeof r);
+    static uint64_t dsp = ~0ull; static uint32_t dsidx;
+    uint64_t pass = g_stat_pass + !g_enc;
+    if (pass != dsp) { dsp = pass; dsidx = 0; }
+    r.frame = atomic_load(&g_cur_frame); r.pass = pass; r.dpass = dsidx++; r.dframe = (uint32_t)g_draw_idx_of;
+    r.prim = dw ? dw->prim : di->prim; r.count = dw ? dw->count : (int)di->count; r.inst = dw ? dw->instances : di->instances;
+    r.indexed = di != NULL; r.first = dw ? (int64_t)dw->first : 0;
+    r.vb0 = S.vbuf[0].address; r.stride = (uint32_t)S.stream[0].stride; r.rastd = (uint32_t)S.rast_discard;
+    r.atst = atst; r.atid = 0; r.aser = 0;
+    os_unfair_lock_lock(&g_rmu);
+    { NvShader *sh = pr->sh[atst];   // the atlas binding as at_bind and the encode see it: the same rule rt_atlas uses
+      for (int i = 0; sh && i < sh->rf.nb; i++) {
+          const nvn_rbind *b = &sh->rf.b[i]; int tid = 0;
+          if ((b->kind == NVN_RB_TEX || b->kind == NVN_RB_TBUF) && b->reg < NTEX) tid = (int)(tex_slot_h(S.tex[atst], S.img[atst], b->reg) & 0xfffff);
+          else if (b->kind == NVN_RB_TEXU) tid = ubo_tex_id(ubo_handle(atst, b->reg, b->off));
+          else continue;
+          if (tid <= 0) continue;
+          void *tv = NULL; if (!tex_fast_rid(tid, &tv) || !tv) continue;
+          id<MTLTexture> t = (__bridge id<MTLTexture>)tv;
+          if (t && t.pixelFormat == MTLPixelFormatR8Unorm && (uint64_t)t.width * t.height >= (2u << 20)) {
+              r.atid = tid; r.aser = (tid < g_ntreg && g_treg[tid].ok) ? g_treg[tid].t.serial : 0; break; }
+      } }
+    os_unfair_lock_unlock(&g_rmu);
+    memcpy(&r.color, &S.color, 4); memcpy(&r.chmask, &S.chmask, 4); memcpy(&r.poly, &S.poly, 4); memcpy(&r.ms0, &S.ms, 4);
+    memcpy(r.blend, S.blend, sizeof r.blend);
+    memcpy(&r.alpha_ref, &S.alpha_ref, 4);
+    memcpy(&r.ds0, &S.ds, 8);
+    r.vmask0 = S.st_vmask[0]; r.vmask1 = S.st_vmask[1]; r.wmask0 = S.st_wmask[0]; r.wmask1 = S.st_wmask[1];
+    r.sref0 = S.st_ref[0]; r.sref1 = S.st_ref[1];

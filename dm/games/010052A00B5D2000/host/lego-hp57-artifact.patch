From 97ff1dccdbe0cbec32ccc91cd6bdac00b630b0a2 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Tue, 17 Nov 2026 06:51:38 -0700
Subject: [PATCH 24/32] diag(nvn): DM_NVN_EMITW -- which guest store writes the
 unit-uv quad into the UI staging array, and the emitter's own inputs

A write watch (dm_watch_dyn) armed on the 112 bytes the quad occupies in the
staging array, with the whole page's store runs (pc, chain, thread, first 8
bytes), so the emitter is identified by measurement rather than by guessing
between the three vertex-build sites. Off unless DM_NVN_EMITW names a file.

Found: nro0 0x6d9810 (sole call site 0x6d9f64) -- a whole-texture blit helper
(uv hard-coded to the unit square, rect y in [2/7,1] from the constants at
0x9e4be4/0x9e4be8) emitting through 0x1053b0 -> 0x15d720 into the text batch.
---
 dm/gfx/nvn/nvn_mtl.m | 129 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 129 insertions(+)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index f38adf8..27acb60 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -10732,6 +10732,7 @@ static int pdx_on(void) {
 static void pdx_put(int fd, const void *p, size_t n) { if (fd >= 0 && n) { ssize_t w = write(fd, p, (size_t)n); (void)w; } }
 static void pdx_line(const char *s) { if (pdx_fd >= 0 && s && *s) { pdx_put(pdx_fd, s, strlen(s)); pdx_put(pdx_fd, "\n", 1); } }
 static float pdx_f32(const uint8_t *p) { float v; memcpy(&v, p, 4); return v; }
+static uint32_t pdx_u32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }
 static int pdx_finite(float v) { return isfinite(v) ? 1 : 0; }
 static void pdx_trip(char *o, size_t cap, const uint8_t *p) {   // a 12-byte position triple as floats, with a non-finite marker
     float x = pdx_f32(p), y = pdx_f32(p + 4), z = pdx_f32(p + 8);
@@ -10872,6 +10873,132 @@ static void pdx_present(void) {   // the same blocks at the present: after the f
     char b[192]; snprintf(b, sizeof b, "[pdxf] f=%llu recs=%d changed_after_draw=%d quads_unit_uv=%d arrdumps=%d", (unsigned long long)f, pdx_nr, nbad, pdx_nq, pdx_na);
     pdx_line(b);
 }
+// DM_NVN_EMITW=<file> (diagnostic, off by default): WHO writes the unit-uv quad into the UI staging array, and what it wrote.
+// The residual lattice is one 4-vertex quad whose uv is the whole font atlas and whose positions are 2*uv-1, appended to an
+// ordinary glyph run (orch/pos, orch/state). No per-draw state singles it out, so the question is the guest store. Method:
+// at every atlas draw, look for the quad's own signature in the block the draw names; when one is found, arm a write watch
+// (dm_watch_dyn, dm/host/probe.c) on the 112 bytes it occupies in the staging array -- [0x1176080] + (block - flush_base) +
+// 28*quad -- so the first store into exactly those bytes is reported with its guest pc, thread, the 8 bytes written and the
+// code that called it. One window per distinct page (the probe's table is small); cleared at every present so each frame
+// reports its own first store. The page's store runs are printed too, which covers the case where the layout moves inside it.
+#define EW_ARMS 4
+#define EW_RUNW 12
+static int ew_fd = -2;
+static struct { uint64_t at, pg; int id; } ew_w[EW_ARMS];
+static int ew_nw;
+static uint64_t ew_A; static int ew_nq, ew_nf;
+static int ew_on(void) {
+    if (ew_fd == -2) {
+        const char *e = getenv("DM_NVN_EMITW");
+        ew_fd = (e && *e) ? open(e, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND, 0644) : -1;
+        if (ew_fd >= 0) MLOG("[ew] DM_NVN_EMITW=%s: the store that writes a unit-uv quad's 112 bytes in the staging array (window watch + its page's store runs)", e);
+        else if (e && *e) MLOG("[ew] DM_NVN_EMITW: cannot open %s", e);
+    }
+    return ew_fd >= 0;
+}
+static void ew_line(const char *b) { if (ew_fd >= 0) { ssize_t w = write(ew_fd, b, strlen(b)); w = write(ew_fd, "\n", 1); (void)w; } }
+static void ew_arm(uint64_t A) {   // one watch on the page holding these 112 bytes; the window is the quad itself
+    uint64_t ps = (uint64_t)getpagesize(), pg = A & ~(ps - 1);
+    if (!dm_watch_dyn) return;
+    for (int i = 0; i < ew_nw; i++) if (ew_w[i].pg == pg) return;
+    if (ew_nw >= EW_ARMS) return;
+    uint64_t len = 112; if (A + len > pg + ps) len = pg + ps - A;
+    char tag[24]; snprintf(tag, sizeof tag, "ew%06llx", (unsigned long long)((pg >> 14) & 0xffffff));
+    int id = dm_watch_dyn(A, len, tag);
+    if (id < 0) return;
+    ew_w[ew_nw].at = A; ew_w[ew_nw].pg = pg; ew_w[ew_nw].id = id; ew_nw++;
+    char b[192]; snprintf(b, sizeof b, "[ewa] id=%d at=%#llx len=%llu pg=%#llx", id, (unsigned long long)A, (unsigned long long)len, (unsigned long long)pg);
+    ew_line(b);
+}
+static void ew_draw(uint64_t a, int count, NvProg *pr) {   // the quad's own signature, then the watch on its array bytes
+    if (!ew_on() || !a || count < 4 || !pr || rt_atlas(pr) < 0) return;
+    uint64_t ab = rt_arr_base(), dst = uip_get(a); uint32_t used = rt_arr_used();
+    if (!ab || !dst || a < dst) return;
+    uint64_t uoff = a - dst, f = atomic_load(&g_cur_frame);
+    if (uoff >= 0x500000 || uoff + (uint64_t)count * 28 > used) return;
+    static uint8_t eb[PDX_CAP];
+    size_t len = (size_t)count * 28; if (len > sizeof eb) return;
+    if (!vb_read(a, len, eb)) return;
+    // Every unit-uv quad of every atlas draw, with the emitter's own inputs beside it: the writer context's per-item
+    // scale/bias (0x11539c8 + 0x74..0x84), the 3-vector the blit helper normalises (0x11b0c30), and the handle it is
+    // called with (0x11b0bb8). A clean frame and a lattice frame are then compared on the emitter's inputs, not the pixels.
+    uint8_t *img = va_img(); uint32_t ctx[5] = {0}, vec[3] = {0}, tex = 0;
+    if (img) {
+        memcpy(ctx, img + 0x11539c8 + 0x74, 20);
+        memcpy(vec, img + 0x11b0c30, 12);
+        memcpy(&tex, img + 0x11b0bb8, 4);
+    }
+    int nq = 0, nbig = 0; uint32_t msp = 0; int q0 = -1;
+    for (int i = 0; i + 4 <= count; i += 4) {
+        const uint8_t *p = eb + (size_t)i * 28;
+        if (!pdx_unit_uv(p)) continue;
+        uint32_t sp = pdx_span(p, 4);
+        nq++; if (q0 < 0) q0 = i / 4;
+        uint32_t sx = sp >> 16, sy = sp & 0xffff;
+        if (sx > 1200 || sy > 700) nbig++;
+        if (sx > (msp >> 16) || sy > (msp & 0xffff)) msp = sp;
+    }
+    {   // one line per atlas draw that holds a unit-uv quad at all (any size), plus a heartbeat: is the element present
+        // in frames that do NOT produce the lattice, and with what transform/handle? Cheap enough not to throttle.
+        static uint64_t hb;
+        if (nq || (f / 240) != hb) {
+            if (!nq) hb = f / 240;
+            char b[320]; const uint8_t *q = q0 >= 0 ? eb + (size_t)q0 * 28 : eb;
+            int o = snprintf(b, sizeof b, "[ewq] f=%llu count=%d uoff=%#llx nq=%d big=%d q0=%d msp=%u.%u ctx=%08x,%08x,%08x,%08x,%08x vec=%08x,%08x,%08x tex=%08x",
+                             (unsigned long long)f, count, (unsigned long long)uoff, nq, nbig, q0, msp >> 16, msp & 0xffff,
+                             ctx[0], ctx[1], ctx[2], ctx[3], ctx[4], vec[0], vec[1], vec[2], tex);
+            if (q0 >= 0) o += snprintf(b + o, sizeof b - (size_t)o, " v0=%08x,%08x,%08x,%08x,%08x,%08x,%08x",
+                                       pdx_u32(q), pdx_u32(q + 4), pdx_u32(q + 8), pdx_u32(q + 12), pdx_u32(q + 16), pdx_u32(q + 20), pdx_u32(q + 24));
+            ew_line(b);
+        }
+    }
+    for (int i = 0; i + 4 <= count; i += 4) {
+        const uint8_t *p = eb + (size_t)i * 28;
+        if (!pdx_unit_uv(p)) continue;
+        uint32_t sp = pdx_span(p, 4);
+        if ((sp >> 16) <= 1200 && (sp & 0xffff) <= 700) continue;   // the lattice's quad spans the screen; a small unit-uv quad is not it
+        uint64_t A = ab + uoff + (uint64_t)i * 28;
+        char b[512]; int o = snprintf(b, sizeof b, "[ew] f=%llu count=%d a=%#llx uoff=%#llx quad=%d A=%#llx span=%u.%u q=",
+                                      (unsigned long long)f, count, (unsigned long long)a, (unsigned long long)uoff, i / 4,
+                                      (unsigned long long)A, sp >> 16, sp & 0xffff);
+        for (int k = 0; k < 4 && o < (int)sizeof b - 80; k++)
+            o += snprintf(b + o, sizeof b - (size_t)o, "%08x%08x%08x%08x%08x%08x%08x", pdx_u32(p + (size_t)k * 28), pdx_u32(p + (size_t)k * 28 + 4),
+                          pdx_u32(p + (size_t)k * 28 + 8), pdx_u32(p + (size_t)k * 28 + 12), pdx_u32(p + (size_t)k * 28 + 16),
+                          pdx_u32(p + (size_t)k * 28 + 20), pdx_u32(p + (size_t)k * 28 + 24));
+        ew_line(b);
+        ew_nq++;
+        if (A != ew_A) { ew_A = A; ew_arm(A); }
+    }
+}
+static void ew_present(void) {   // what the armed windows saw this frame, then clear them so the next frame's first store is caught again
+    if (!ew_on() || !ew_nw) return;
+    uint64_t f = atomic_load(&g_cur_frame);
+    for (int i = 0; i < ew_nw; i++) {
+        uint64_t n = 0, ft = 0, lt = 0, ea = 0, ov = 0, nv = 0, pc = 0; uint32_t tid = 0;
+        if (dm_watch_dyn_get && dm_watch_dyn_get(ew_w[i].id, &n, &ft, &lt, &tid, &pc, &ea, &ov, &nv) && n) {
+            char pcs[96], c0[96]; rt_addr(pcs, sizeof pcs, pc);
+            uint64_t fp2 = 0; (void)fp2; c0[0] = 0;
+            char b[352]; snprintf(b, sizeof b, "[ewp] f=%llu i=%d at=%#llx n=%llu tid=%u pc=%s ea=%#llx new=%016llx t=%9.6f",
+                                  (unsigned long long)f, i, (unsigned long long)ew_w[i].at, (unsigned long long)n, tid, pcs,
+                                  (unsigned long long)ea, (unsigned long long)nv, (double)ft / 1e9);
+            ew_line(b); ew_nf++;
+        }
+        if (dm_watch_dyn_runs && dm_watch_dyn_runs_clear) {
+            uint64_t o2[EW_RUNW * 6]; int nr = dm_watch_dyn_runs(ew_w[i].id, 6, o2);
+            for (int r = 0; r < nr; r++) {
+                uint64_t *q = &o2[EW_RUNW * r]; char pcs[96], c0[96], c1[96], c2[96];
+                rt_addr(pcs, sizeof pcs, q[4]); rt_addr(c0, sizeof c0, q[7]); rt_addr(c1, sizeof c1, q[8]); rt_addr(c2, sizeof c2, q[9]);
+                char b[448]; snprintf(b, sizeof b, "[ewr] f=%llu i=%d ea=%#llx..%#llx n=%llu tid=%llu pc=%s v0=%016llx chain=%s<-%s<-%s",
+                                      (unsigned long long)f, i, (unsigned long long)q[0], (unsigned long long)q[1],
+                                      (unsigned long long)((q[1] - q[0]) / 16), (unsigned long long)q[6], pcs, (unsigned long long)q[5], c0, c1, c2);
+                ew_line(b);
+            }
+            dm_watch_dyn_runs_clear(ew_w[i].id);
+        }
+        if (dm_watch_dyn_clear) dm_watch_dyn_clear(ew_w[i].id);
+        if (dm_watch_dyn_rearm) dm_watch_dyn_rearm(ew_w[i].id);
+    }
+}
 // DM_NVN_STATEREC=<file> (diagnostic, off by default): one fixed-size binary record per atlas (font-atlas-sampling) draw
 // with every piece of per-draw state a picture can depend on: blend enable per target, blend factors and equations for
 // colour and alpha separately, the alpha test (function, reference value, whether the shader can take the test, whether

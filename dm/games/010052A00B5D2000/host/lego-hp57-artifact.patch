+// why: 0 a submission began, 1 a guest wait on fence <= f, 2 that frame's present, 3 drain / teardown
+static void lag_pump(int why, uint64_t f) {
+    if (!g_lag_n) return;
+    pthread_mutex_lock(&g_lag_mu);

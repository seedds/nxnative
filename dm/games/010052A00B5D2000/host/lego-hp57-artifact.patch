 dm/gfx/tests/nvn_replay.m     |   5 ++
 dm/gfx/tests/t_capture_live.m |   4 +
 dm/gfx/tests/t_host_stubs.c   |  14 ++++
 4 files changed, 136 insertions(+), 34 deletions(-)


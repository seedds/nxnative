+static void uip_probe_b(void) {   // DM_NVN_UIP_PROBE: the other two staging arrays' trios, once per 600 frames
+    // STEP 3 of the residual work: is the residual a second staging array with the same publish-before-produce shape, or a
+    // 12-byte-element array with another consumer? An array that is never populated (used == 0) cannot be a stale source for
+    // any draw, so its cursor answers that without a per-draw cost. Reads only; off unless DM_NVN_UIP_PROBE is set.
+    static int on = -1; if (on < 0) on = getenv("DM_NVN_UIP_PROBE") != NULL; if (!on) return;
+    uint8_t *m = va_img(); if (!m) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if ((f % 600) != 0) return;
+    uint64_t b2 = *(volatile uint64_t *)(m + 0x1176498);
+    uint32_t u2 = *(volatile uint32_t *)(m + 0x117648c);
+    uint64_t b3 = *(volatile uint64_t *)(m + 0x11764a0);
+    uint32_t u3 = *(volatile uint32_t *)(m + 0x11764a4);
+    uint64_t b1 = *(volatile uint64_t *)(m + 0x1176080);
+    uint32_t u1 = *(volatile uint32_t *)(m + 0x1176088);
+    MLOG("[uipb] f=%ld A1(base=%#llx used=%#x) B2(base=%#llx used=%#x) B3(base=%#llx used=%#x)", f,
+         (unsigned long long)b1, u1, (unsigned long long)b2, u2, (unsigned long long)b3, u3);
+}
+static void uip_snap(void) {   // at every present: the array as it will be copied by the next frame's flush
+    if (uip_mode() <= 0) return;
+    uint8_t *m = va_img(); if (!m) return;
+    uint64_t ab = *(volatile uint64_t *)(m + 0x1176080);
+    uint32_t used = *(volatile uint32_t *)(m + 0x1176088);
+    if (!ab || used < 0x40 || used > 0x500000 || !dm_guest_as_contains((uintptr_t)ab)) return;
+    if (!uip_prev) { uip_prev = malloc(0x500000); if (!uip_prev) return; }
+    memcpy(uip_prev, (const void *)(uintptr_t)ab, used); uip_prevused = used; uip_prevok = 1;
+}
+static void uip_draw(uint64_t a) {   // from the draw path, before the draw is encoded: measure the flush's base and publish once per frame
+    int mode = uip_mode(); if (mode <= 0 || !a) return;
+    uint8_t *m = va_img(); if (!m) return;
+    uint64_t ab = *(volatile uint64_t *)(m + 0x1176080);
+    uint32_t used = *(volatile uint32_t *)(m + 0x1176088);
+    if (!ab || used < 0x40 || used > 0x500000 || !dm_guest_as_contains((uintptr_t)ab)) return;
+    int k = uip_slot(a); if (k < 0) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    const uint8_t *cur = (const uint8_t *)(uintptr_t)ab;
+    uip_s[k].lastf = f;
+    int vc = uip_s[k].valid ? uip_vfy(uip_s[k].dst, cur, used) : 0;                                  // the pool already holds this frame's array
+    int vp = (uip_s[k].valid && uip_prevok) ? uip_vfy(uip_s[k].dst, uip_prev, uip_prevused) : 0;     // or the flush's copy of the last one
+    int v = vc > vp ? vc : vp;
+    if (v < 3) {   // not known, or it moved: measure it from this draw's own block (the block is D + its array offset)
+        uint8_t n16[16]; char how = '-';
+        if (dm_guest_as_contains((uintptr_t)a) ? (memcpy(n16, (const void *)(uintptr_t)a, 16), 1) : vb_read(a, 16, n16)) {
+            uint64_t off = UINT64_MAX, dst = 0; int v2 = 0;
+            for (uint32_t from = 0, tries = 0; tries < 8; tries++) {
+                off = uip_off_in(cur, used, n16, from); how = 'f';                                  // this frame's array first,
+                if (off == UINT64_MAX && uip_prevok) { off = uip_off_in(uip_prev, uip_prevused, n16, from); how = 'p'; }   // then the last one
+                if (off == UINT64_MAX) break;
+                dst = a - off;
+                int v3 = uip_vfy(dst, cur, used), v4 = uip_prevok ? uip_vfy(dst, uip_prev, uip_prevused) : 0;
+                v2 = v3 > v4 ? v3 : v4;
+                if (v2 >= 3) break;
+                from = (uint32_t)off + 1; dst = 0;
+            }
+            if (dst && v2 >= 3) {
+                uip_s[k].dst = dst; uip_s[k].koff = off; uip_s[k].valid = 1; uip_s[k].nfind++; uip_nseek++; v = v2;
+                MLOG("[uipm] f=%ld slot=%#llx a=%#llx array=%c off=%#llx dst=%#llx used=%#x ch=%d (the flush's base, measured from this draw's block)",
+                     f, (unsigned long long)(a & ~(uint64_t)0x7fffff), (unsigned long long)a, how, (unsigned long long)off,
+                     (unsigned long long)dst, used, v2);
+            } else {
+                MLOG("[uipm] f=%ld slot=%#llx a=%#llx array=%c off=%#llx used=%#x ch=%d NO BASE (the block's bytes are in neither array)",
+                     f, (unsigned long long)(a & ~(uint64_t)0x7fffff), (unsigned long long)a, how,
+                     (unsigned long long)(off == UINT64_MAX ? 0 : off), used, v2);
+            }
+        }
+    } else if (uip_s[k].valid) uip_s[k].nvfy++;
+    int first = (f != uip_lastf);
+    if (first) uip_lastf = f;
+    uint64_t dst = uip_s[k].valid ? uip_s[k].dst : 0;
+    if (dst) uip_s[k].koff = a - dst;   // this frame's measured relation: the bound block is flush_base + k
+    uint8_t hd[64]; uint64_t h_arr = uip_h64(cur, 64), h_before = 0, h_after = 0;
+    if (dst) h_before = vb_read(dst, 64, hd) ? uip_h64(hd, 64) : 0;
+    uint32_t kb = (uint32_t)uip_s[k].koff; if (kb + 64 > used) kb = used > 64 ? used - 64 : 0;   // the block this frame's first UI draw names
+    uint64_t hk_arr = uip_h64(cur + kb, 64), hk_before = 0, hk_after = 0;
+    if (dst) hk_before = vb_read(dst + kb, 64, hd) ? uip_h64(hd, 64) : 0;
+    uint32_t ncopied = 0; int ok = 0;
+    if ((mode & 1) && dst) {   // the publish itself: this frame's emission, over the destination the flush wrote
+        void *mb = NULL; uint64_t mo = 0;
+        if (mtl_addr(dst, used, &mb, &mo)) {
+            uint8_t *dp = (uint8_t *)[(__bridge id<MTLBuffer>)mb contents];
+            if (dp) { memcpy(dp + mo, cur, used); ncopied = used; uip_ncop++; uip_nbyte += used; }
+        }
+        h_after = vb_read(dst, 64, hd) ? uip_h64(hd, 64) : 0;   // read back through the GPU's own buffer, not the pointer just written
+        hk_after = vb_read(dst + kb, 64, hd) ? uip_h64(hd, 64) : 0;
+        ok = (h_after == h_arr);
+        if (ok) uip_nok++; else uip_nbad++;
+    } else if (!dst) uip_nnomatch++;
+    if (mode < 3 || ((f % 600) == 0 && first) || !dst || ((mode & 1) && !ok))
+        MLOG("[uip] f=%ld slot=%#llx a=%#llx dst=%#llx k=%#llx used=%#x ch=%d copied=%u h_arr=%016llx h_before=%016llx h_after=%016llx hk_arr=%016llx hk_before=%016llx hk_after=%016llx ok=%d ncop=%llu nok=%llu nbad=%llu nomatch=%llu",
+             f, (unsigned long long)(a & ~(uint64_t)0x7fffff), (unsigned long long)a, (unsigned long long)dst,
+             (unsigned long long)uip_s[k].koff, used, v, ncopied,
+             (unsigned long long)h_arr, (unsigned long long)h_before, (unsigned long long)h_after,
+             (unsigned long long)hk_arr, (unsigned long long)hk_before, (unsigned long long)hk_after, ok,
+             (unsigned long long)uip_ncop, (unsigned long long)uip_nok, (unsigned long long)uip_nbad, (unsigned long long)uip_nnomatch);
+}
+static void uip_present_pub(void) {   // at every present: the array is complete for this frame now, so publish it once more
+    // Some UI objects are written to the array after the draw that names them has been recorded and after the submission
+    // (measured: 4 of 3,165 traced draws read a block whose bytes the array received later in the same frame). The present is
+    // the last host-side moment before the GPU executes this frame's commands, and it is the point at which the array holds
+    // the frame's final emission. Only the slot this frame's own UI draws named is written.
+    int mode = uip_mode(); if (mode <= 0 || (mode & 1) == 0) return;
+    uint8_t *m = va_img(); if (!m) return;
+    uint64_t ab = *(volatile uint64_t *)(m + 0x1176080);
+    uint32_t used = *(volatile uint32_t *)(m + 0x1176088);
+    if (!ab || used < 0x40 || used > 0x500000 || !dm_guest_as_contains((uintptr_t)ab)) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    const uint8_t *cur = (const uint8_t *)(uintptr_t)ab;
+    for (int k = 0; k < uip_ns; k++) {
+        if (!uip_s[k].valid || uip_s[k].lastf != f) continue;
+        uint64_t dst = uip_s[k].dst;
+        uint8_t hd[64];
+        uint64_t h_before = vb_read(dst, 64, hd) ? uip_h64(hd, 64) : 0, h_arr = uip_h64(cur, 64), h_after = 0;
+        uint32_t n = 0;
+        void *mb = NULL; uint64_t mo = 0;
+        if (mtl_addr(dst, used, &mb, &mo)) {
+            uint8_t *dp = (uint8_t *)[(__bridge id<MTLBuffer>)mb contents];
+            if (dp) { memcpy(dp + mo, cur, used); n = used; uip_ncop++; uip_nbyte += used; }
+        }
+        h_after = vb_read(dst, 64, hd) ? uip_h64(hd, 64) : 0;
+        int ok = (h_after == h_arr);
+        if (n && ok) uip_nok++; else if (n) uip_nbad++;
+        if (mode < 3 || ((f % 600) == 0) || !ok)
+            MLOG("[uipr] f=%ld slot=%#llx dst=%#llx used=%#x copied=%u h_arr=%016llx h_before=%016llx h_after=%016llx ok=%d ncop=%llu nok=%llu nbad=%llu",
+                 f, (unsigned long long)uip_s[k].slot, (unsigned long long)dst, used, n,
+                 (unsigned long long)h_arr, (unsigned long long)h_before, (unsigned long long)h_after, ok,
+                 (unsigned long long)uip_ncop, (unsigned long long)uip_nok, (unsigned long long)uip_nbad);
+    }
+}
+static void uip_submit(void) {   // at every submission: publish again, to the slots this frame's UI draws used
+    // Between a UI draw and the submission the producer can still write the array (measured: 4 of 3,161 traced draws read a
+    // block the array had not been given yet at the draw, and it holds the new value by the present). This second copy is
+    // the last moment before the command buffer goes to the GPU, so it carries those writes as well. Only the slots this
+    // frame's own UI draws named are written: the other slots hold frames that may still be in flight.
+    int mode = uip_mode(); if (mode <= 0 || (mode & 1) == 0) return;
+    uint8_t *m = va_img(); if (!m) return;
+    uint64_t ab = *(volatile uint64_t *)(m + 0x1176080);
+    uint32_t used = *(volatile uint32_t *)(m + 0x1176088);
+    if (!ab || used < 0x40 || used > 0x500000 || !dm_guest_as_contains((uintptr_t)ab)) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    const uint8_t *cur = (const uint8_t *)(uintptr_t)ab;
+    for (int k = 0; k < uip_ns; k++) {
+        if (!uip_s[k].valid || uip_s[k].lastf != f) continue;
+        uint64_t dst = uip_s[k].dst;
+        uint8_t hd[64];
+        uint64_t h_before = vb_read(dst, 64, hd) ? uip_h64(hd, 64) : 0, h_arr = uip_h64(cur, 64), h_after = 0;
+        uint32_t n = 0;
+        void *mb = NULL; uint64_t mo = 0;
+        if (mtl_addr(dst, used, &mb, &mo)) {
+            uint8_t *dp = (uint8_t *)[(__bridge id<MTLBuffer>)mb contents];
+            if (dp) { memcpy(dp + mo, cur, used); n = used; uip_ncop++; uip_nbyte += used; }
+        }
+        h_after = vb_read(dst, 64, hd) ? uip_h64(hd, 64) : 0;
+        int ok = (h_after == h_arr);
+        if (n && ok) uip_nok++; else if (n) uip_nbad++;
+        if (mode < 3 || ((f % 600) == 0) || !ok)
+            MLOG("[uips] f=%ld slot=%#llx dst=%#llx used=%#x copied=%u h_arr=%016llx h_before=%016llx h_after=%016llx ok=%d ncop=%llu nok=%llu nbad=%llu",
+                 f, (unsigned long long)uip_s[k].slot, (unsigned long long)dst, used, n,
+                 (unsigned long long)h_arr, (unsigned long long)h_before, (unsigned long long)h_after, ok,
+                 (unsigned long long)uip_ncop, (unsigned long long)uip_nok, (unsigned long long)uip_nbad);
+    }
+}
 static void rt_draw(NvProg *pr, const p_draw *dw, const p_draw_idx *di) {   // the atlas-sampling draws: the UI glyph runs and the full-screen quad

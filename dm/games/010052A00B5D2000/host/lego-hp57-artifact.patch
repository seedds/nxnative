+// ---------------- DM_NVN_UI_REPUBLISH: publish the UI staging array after the frame has produced it ----------------
+// The flush at nro0+0x1bc9b0 copies the staging array ([0x1176080], used [0x1176088]) into a pool buffer at *frame
+// begin*, before the frame's own emission exists, so the block a UI draw names holds the previous frame's bytes at that
+// offset (orch/pool-fix/REPORT.md §2, byte-exact). The emission is complete before the frame records or encodes any UI
+// draw (measured: the array's `used` is 0xf900 at the frame's first UI bind and at every UI draw of the frame), so the
+// publish can be made at the frame's first UI draw instead: one memcpy of the array over the destination the flush
+// itself writes, on the same thread, immediately before the draw that reads it is encoded.
+// The destination is *measured*, never guessed. The flush copies array[0..used) to a pool base D and the recorder bakes
+// a draw's payload as D + (that object's array offset), so for every UI draw 0 <= a - D < used. This hook therefore
+// (a) snapshots the array at every present (exactly what the next flush will copy), (b) takes the block a UI draw names,
+// finds those bytes in the array (memmem, then 4 chunks spread over the whole range verify the base that implies), which
+// gives D per ring slot, and (c) copies array[0..used) to D once per frame, reading the destination back through the
+// GPU's own buffer afterwards. A base that stops verifying is re-measured and logged, never written blind.
+// `uoff = a - D` (the block's array offset) is printed in the ring trace's draw lines: that is the measured relation
+// between the flush's base and the address a draw binds.
+// modes: unset/0 off (today exactly); 1 copy + one line per frame; 2 measure only, no write (the control); 3 copy, and
+// log only every 600th frame (for rate runs: a line per frame is itself a timing change).
+#define UIP_SLOTS 4
+// The default is the title's own profile key (`ui_republish`, game.tsv -> DM_GAME_UI_REPUBLISH): the destination is measured
+// from the guest's UI array bytes, so the copy is only meaningful for the title whose UI pool mirrors that array. 0 keeps the
+// host's global behaviour: no work in any of the four hooks.
+static int uip_mode(void) { static int v = -1; if (v < 0) { const char *e = getenv("DM_NVN_UI_REPUBLISH"); v = (e && *e) ? atoi(e) : DM_GAME_UI_REPUBLISH; MLOG("UI republish (the staging array published after the frame produced it): %s (profile key ui_republish; DM_NVN_UI_REPUBLISH overrides)", v == 2 ? "measure only" : (v & 1) ? "copy" : "off"); } return v; }
+static struct { uint64_t slot, dst, koff; long lastf; int valid, nfind, nvfy; } uip_s[UIP_SLOTS]; static int uip_ns;
+static long uip_lastf = -1;
+static uint8_t *uip_prev; static uint32_t uip_prevused; static int uip_prevok;   // the array as the next flush will copy it
+static uint64_t uip_ncop, uip_nbyte, uip_nok, uip_nbad, uip_nnomatch, uip_nseek;
+static uint64_t uip_h64(const uint8_t *p, size_t n) { uint64_t h = 0xcbf29ce484222325ull; for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 0x100000001b3ull; } return h; }
+static int uip_slot(uint64_t a) {   // the 8 MB ring slot this address is in (own table: the trace's index needs the write watch armed)
+    uint64_t s = a & ~(uint64_t)0x7fffff;
+    for (int k = 0; k < uip_ns; k++) if (uip_s[k].slot == s) return k;
+    if (uip_ns >= UIP_SLOTS) return -1;
+    uip_s[uip_ns].slot = s; uip_s[uip_ns].dst = 0; uip_s[uip_ns].koff = 0; uip_s[uip_ns].lastf = -1; uip_s[uip_ns].valid = 0; uip_s[uip_ns].nfind = 0; uip_s[uip_ns].nvfy = 0;
+    return uip_ns++;
+}
+static uint64_t uip_get(uint64_t a) {   // the measured flush base of this address's slot, 0 when not known yet (read by rt_draw)
+    uint64_t s = a & ~(uint64_t)0x7fffff;
+    for (int k = 0; k < uip_ns; k++) if (uip_s[k].slot == s && uip_s[k].valid) return uip_s[k].dst;
+    return 0;
+}
+static int uip_vfy(uint64_t d, const uint8_t *arr, uint32_t used) {   // does the pool at d hold that array? chunks matched of 4 (0, 1/3, 2/3, tail)
+    if (!d || !arr || used < 0x40) return 0;
+    uint32_t o[4]; o[0] = 0; o[1] = (used / 3) & ~3u; o[2] = ((2 * used) / 3) & ~3u; o[3] = (used - 0x40) & ~3u;
+    int ok = 0;
+    for (int i = 0; i < 4; i++) {

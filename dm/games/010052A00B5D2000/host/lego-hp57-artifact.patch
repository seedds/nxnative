From 873ecd59b0f02138db555cdf4f15747570ca7988 Mon Sep 17 00:00:00 2001
From: orch <orch@local>
Date: Tue, 17 Nov 2026 06:31:41 -0700
Subject: [PATCH 23/32] diag(nvn): DM_NVN_STATEREC -- the per-draw state of
 every atlas draw (blend, alpha test, mask, depth, stencil, cull, viewport,
 scissor, formats) as a binary record, and the quad's own vertices

The residual lattice is one unit-uv quad in a glyph run. Every earlier instrument has looked at the vertex bytes, the
uniform blocks, the ring and the pool; none has looked at the draw's *state*, and the two that could (DM_NVN_DRAWSTATE,
DM_NVN_PASSDUMP) either hide the artifact by their own cost or do not print the alpha test at all.

One fixed-size record per font-atlas-sampling draw: blend enable per target, blend factors and equations for colour and
alpha separately (all 8 targets), the alpha test function, reference and whether the host would apply the library, the
colour write mask, depth test / write / compare, stencil test, both compare functions, all six operations, read and write
masks and both references, cull / front face / fill, viewport and depth range, the scissor as the guest set it, the
target's size, colour and depth formats and sample count, both program keys, prim / count / instances / stride, the atlas
texture id and serial, and for a draw whose 28-byte stream holds the lattice's own signature (a unit-uv quad spanning the
screen) that quad's four vertices.

Measured with it (orch/state/REPORT.md): the lattice draw's state is identical to the clean frame's in 29 of 31 fields,
the two being the ring address and the flag itself; alpha_func is ALWAYS with reference 0 on all 52,367 (st1) and 50,447
(st2) atlas draws of a run -- this title never enables the alpha test for a UI draw -- and the lattice draws' state
signature occurs thousands of times without a lattice. No host fix follows; the emitter is the site.

Off unless DM_NVN_STATEREC names a file (then one static-int test per atlas draw); writes nothing per draw but 464 bytes
appended to a buffer flushed once per present, because the per-draw state read of DM_NVN_DRAWSTATE is measured to remove
this artifact class entirely. Kill switch: unset the variable or revert this commit.
---
 dm/gfx/nvn/nvn_mtl.m | 111 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 111 insertions(+)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 14d02c2..f38adf8 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -10872,6 +10872,115 @@ static void pdx_present(void) {   // the same blocks at the present: after the f
     char b[192]; snprintf(b, sizeof b, "[pdxf] f=%llu recs=%d changed_after_draw=%d quads_unit_uv=%d arrdumps=%d", (unsigned long long)f, pdx_nr, nbad, pdx_nq, pdx_na);
     pdx_line(b);
 }
+// DM_NVN_STATEREC=<file> (diagnostic, off by default): one fixed-size binary record per atlas (font-atlas-sampling) draw
+// with every piece of per-draw state a picture can depend on: blend enable per target, blend factors and equations for
+// colour and alpha separately, the alpha test (function, reference value, whether the shader can take the test, whether
+// the host's atest_key would select the test library), the colour write mask, depth test / write / compare function,
+// stencil (test, front / back compare functions, ops, read and write masks, both reference values), cull / front face /
+// fill mode, viewport and depth range, the scissor rect as the guest set it, the pass's colour / depth / stencil formats
+// and sample count, the three program keys, prim / count / instances, the vertex stream, and the atlas stage / slot /
+// texture id / serial. It also flags a draw whose 28-byte-stride stream contains the residual lattice's own signature (a
+// unit-uv quad whose positions span the screen) and the vertex it starts at.
+// Why a separate instrument: DM_NVN_DRAWSTATE reads every uniform block per draw and formats a kilobyte line, which is
+// measured to remove this artifact class entirely (orch/ubo §1, the DSPROBE note) -- it is a throttle, not a measurement.
+// This one reads no uniform block and formats nothing per draw: it appends ~200 bytes and writes them once per present.
+#define SRT_BUF (1u << 20)
+typedef struct {
+    uint64_t frame, pass;               // guest frame, global pass number (as in the P / D lines)
+    uint32_t dpass, dframe;             // draw index in this pass, draw index in this guest frame (DM_NVN_DRAW_RANGE's number)
+    int32_t  prim, count, inst, indexed;
+    int64_t  first;
+    uint64_t vb0; uint32_t stride, rastd;
+    int32_t  atst, atid; uint64_t aser; // atlas stage / texture id / texture serial
+    uint32_t color, chmask, poly, ms0;  // raw state words: color_st (blend_en:8 logic_op:4 alpha_func:4), chmask_st, poly_st, ms_st.enable|samples|a2c|a2c_dither
+    uint32_t vmask0, vmask1, wmask0, wmask1, sref0, sref1;
+    uint32_t ds0, ds1;                  // ds_st as two 32-bit words (dt:1 dw:1 df:4 st:1 sf_f:4 sf_b:4 | fail_f:4 zfail_f:4 zpass_f:4 fail_b:4 zfail_b:4 zpass_b:4)
+    uint64_t blend[8];                  // blend_st per target (target:3 src_rgb:7 dst_rgb:7 src_a:7 dst_a:7 eq_rgb:3 eq_a:3 adv:6 adv_npm:1 adv_ovl:2)
+    uint32_t alpha_ref;                 // SetAlphaRef, as bits
+    int32_t  vp[4]; float dr[2]; int32_t has_vp;
+    int32_t  sc[4]; int32_t has_sc;     // the scissor as the guest set it (before the host clamps it to the target)

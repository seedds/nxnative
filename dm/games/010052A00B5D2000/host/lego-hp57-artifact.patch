     uint64_t t0 = now_ns(); int ok = w(o->fence, timeout); atomic_fetch_add(&g_sync_ns, now_ns() - t0);   // the frame's blocked SyncWait time (@sync_ms)
+    if (synclog()) LOG("[synclog] fence=%llu newest=%llu done=%llu behind=%lld timeout=%llu us blocked=%.3f ms result=%s",
+        (unsigned long long)o->fence, (unsigned long long)nf, (unsigned long long)dn, (long long)(nf - o->fence),

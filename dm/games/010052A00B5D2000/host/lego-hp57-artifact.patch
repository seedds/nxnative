 // with every piece of per-draw state a picture can depend on: blend enable per target, blend factors and equations for
 // colour and alpha separately, the alpha test (function, reference value, whether the shader can take the test, whether
@@ -11327,6 +11497,8 @@ static void draw_(const p_draw *dw, const p_draw_idx *di) {
     rt_draw(pr, dw, di);   // DM_NVN_RINGTRACE: the UI ring's read side (the atlas draws' stream address, its bytes, this thread, this time)
     pdx_draw(S.vbuf[0].address, (int)(dw ? dw->count : di ? di->count : 0), pr);   // DM_NVN_POSDUMP: this block's POSITIONS against the array at the same offset, and again at the present
     ew_draw(S.vbuf[0].address, (int)(dw ? dw->count : di ? di->count : 0), pr);   // DM_NVN_EMITW: which guest store writes the unit-uv quad into the staging array (arms a page watch on its 112 bytes)
+    if (uvr_on() && (int)S.stream[0].stride == 28)   // DM_NVN_UVRING: is the unit-uv blit quad in this stream? (a dozen integer compares)
+        uvr_draw(S.vbuf[0].address, (int)(dw ? dw->count : di ? di->count : 0), (int)(dw ? dw->prim : di->prim), pr);
     ubdv_draw(pr, dw, di);   // DM_NVN_UBDUMP: the vertex-stage uniform values this atlas draw binds, and what the block holds at the present
     va_ev("draw", S.vbuf[0].address, (long)(dw ? dw->count : di ? di->count : -1));   // DM_VARRAY: the address this draw's payload names, at the replay
     draw_gs_check(pr);   // a geometry stage left with no function (see prog_fold_gs)
@@ -13841,6 +14013,7 @@ static uint64_t present_enqueue(const tex_t *t, double period, const int crop[4]
     rt_present();   // DM_NVN_RINGTRACE: this present, the three ring slots' contents, and what the write watches saw since the last one
     pdx_present();   // DM_NVN_POSDUMP: this frame's UI blocks as the present leaves them, against the bytes each draw saw
     ew_present();    // DM_NVN_EMITW: what the armed array windows saw this frame (the first store into the quad's bytes, with its guest pc)
+    uvr_present();   // DM_NVN_UVRING: this frame's unit-uv quad count, and one line a second
     srt_present();   // DM_NVN_STATEREC: this frame's per-atlas-draw state records, on disk before the next frame is encoded
     ubdv_present();   // DM_NVN_UBDUMP: the uniform blocks this frame's atlas draws read, read again here (before the GPU finishes the frame)
     if (g_classic || atomic_load(&g_present_discard)) return 0;   // Ticket number 0 = no pending present; the swapchain texture acquire does not wait (g_classic: no Metal 4 queue to present on)

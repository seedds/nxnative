From 703c9e0163f65546cd111054564988c34a5eede4 Mon Sep 17 00:00:00 2001
From: thatSchloesser <sschloesser2@gmail.com>
Date: Tue, 17 Nov 2026 04:45:18 -0700
Subject: [PATCH 20/32] diag(nvn): DM_NVN_RINGTRACE_UB -- what the uniform
 binding holds at every atlas draw

Adds one FNV-64 per 64 bytes of every bound UBO in stages 0/1 to the RINGTRACE `ev=draw`
line, behind its own env var (off by default; one getenv, cached). It answers the question
the array-side instruments cannot: whether the draw that paints the residual glyph lattice
reads a uniform slot the guest has not written.

Measured on 2026-11-17 with it on (runs/ub1, 83 A-flagged frames): no zero and no 0xff
(FNV of unreadable/empty) hash in any slot at any A frame, 0/75 A frames with any bad slot
and 0/1831 clean frames. The residual is not an unwritten uniform slot.
---
 dm/gfx/nvn/nvn_mtl.m | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index e436656..45bd28f 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -10516,6 +10516,27 @@ static void rt_draw(NvProg *pr, const p_draw *dw, const p_draw_idx *di) {   // t
     uint8_t q[16]; int ok = vb_read(a, sizeof q, q);
     char cls = ok ? vb_class(a) : '?';
     uint64_t f = atomic_load(&g_cur_frame);
+    // DM_NVN_RINGTRACE_UB: hash the uniform binding each atlas draw reads (stage 0 = vertex, the stage that
+    // places the glyph quads). One FNV-64 per 64 bytes of every bound slot, 0xffffffffffffffff = unreadable.
+    // Off by default: a UI draw issues a handful of ubo reads and this only adds ~3 KB of reads per frame.
+    char ub[192]; ub[0] = 0;
+    static int ub_on = -1; if (ub_on < 0) ub_on = getenv("DM_NVN_RINGTRACE_UB") != NULL;
+    if (ub_on) {
+        uint8_t *m = va_img(); int n2 = 0;
+        n2 += snprintf(ub + n2, sizeof ub - n2, " ub=");
+        for (int st = 0; st < 2; st++)
+            for (int r = 0; r < 6; r++) {
+                const p_bind_buf *u = &S.ubo[st][r];
+                uint64_t hh = 0;
+                if (u->addr && u->size && m && dm_guest_as_contains((uintptr_t)u->addr)) {
+                    const uint8_t *p = (const uint8_t *)(uintptr_t)u->addr;
+                    size_t nn = u->size < 64 ? u->size : 64;
+                    hh = 0xcbf29ce484222325ull;
+                    for (size_t i = 0; i < nn; i++) { hh ^= p[i]; hh *= 0x100000001b3ull; }
+                } else hh = ~0ull;

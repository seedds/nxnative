          (unsigned long long)(qin - qread), (unsigned long long)qread, (unsigned long long)qdone);
 }
+// DM_NVN_FULLSYNC: how a submission is serialised against the GPU before the guest is allowed to continue (0/unset = today's
+// behaviour, nothing added). Guest pools are zero-copy MTLBuffers over guest pages and the vertex / index / uniform streams bind
+// the GUEST GPU ADDRESS itself, so Metal reads those bytes at EXECUTION while the host only read the descriptors at ENCODE. A
+// guest that rewinds and re-fills its frame arena therefore overwrites bytes a submission already committed still has to read.
+//   1 = wait for this submission's own fence: the guest never runs ahead of the GPU (full serialisation).
+//   2 = wait for the previous submission's fence: one submission in flight.
+static int fullsync(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("DM_NVN_FULLSYNC"); v = e ? atoi(e) : 0; if (v > 0) MLOG("DM_NVN_FULLSYNC=%d: %s", v, v == 1 ? "a submission returns to the guest only after its own fence completed" : "a submission waits for the previous one's fence (one in flight)"); }

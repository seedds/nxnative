+static void srt_draw(NvProg *pr, const p_draw *dw, const p_draw_idx *di) {
+    if (srt_fd == -2) {
+        const char *e = getenv("DM_NVN_STATEREC");
+        srt_fd = (e && *e) ? open(e, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND, 0644) : -1;
+        if (srt_fd >= 0) MLOG("[srt] DM_NVN_STATEREC=%s: one %zu-byte record per atlas draw (blend, alpha test, mask, depth, stencil, cull, viewport, scissor, formats, keys, prim/count, atlas serial)", e, sizeof(srt_rec));
+        else if (e && *e) MLOG("[srt] DM_NVN_STATEREC: cannot open %s", e);

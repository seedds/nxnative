From a33e26b265660b6f934db4869c76200c7790e71c Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Tue, 17 Nov 2026 05:40:23 -0700
Subject: [PATCH 21/32] diag(nvn): DM_NVN_UBDUMP -- the vertex-stage uniform
 VALUES an atlas draw reads

Every draw that samples the font atlas now reports, when DM_NVN_UBDUMP names a file, what its vertex stage actually
reads: each declared uniform buffer's guest address, size, ring slot and address delta, whether the bytes come from the
inline uniform updates the host defers (the shadow the GPU reads, nvn_mtl.m:7138-7141) or from guest memory, whether
they still hold the previous frame's bytes, the count of zero / NaN / Inf / denormal / |x|>1e4 words, and the whole
block as 64 floats. The same blocks are re-read at the present, so "the guest wrote it after the draw" is measured
rather than assumed. Off by default (one static-int test in the draw and present paths); DM_NVN_UBDUMP_N caps the draws
a frame, DM_NVN_UBDUMP_W arms a dm_watch_dyn page watch for the writer.

It settles the transform/UBO lead: over three 215 s runs (2 + 7 + 3 lattice presents in 8,143 / 7,925 / 7,939 gameplay
presents) the lattice frames' glyph draws bind the same block at the same address from the same source with the same
bytes as their clean neighbours -- identity UV matrix, no NaN/Inf/denormal, same program, prim, count, stride and atlas
serial -- and 96.1 % of those blocks are read from the deferred shadow, which is fixed at replay. The only non-finite
blocks in the runs are at boot (f=1899-1900) and are not lattice presents. No behaviour change; orch/ubo/REPORT.md.
---
 dm/gfx/nvn/nvn_mtl.m | 184 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 184 insertions(+)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 45bd28f..b9c456d 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -10507,6 +10507,188 @@ static void uip_submit(void) {   // at every submission: publish again, to the s
                  (unsigned long long)uip_ncop, (unsigned long long)uip_nok, (unsigned long long)uip_nbad);
     }
 }
+// ---------------- DM_NVN_UBDUMP=<file>: the uniform VALUES an atlas draw reads, and what the block holds by the present ----------------
+// The residual lattice (orch/final/REPORT.md §0.3) is the glyph shader covering the screen with atlas UVs on single presents whose draw
+// list, program and texture serials match a clean frame's. A full-screen transform is the one input that can produce that with correct
+// vertices, and the *values* a glyph draw's vertex-stage uniform block holds have never been recorded: DM_NVN_RINGTRACE_UB hashes them,
+// ubo_read only ever decodes CPU-side bindless handles. This writes, for every draw that samples the font atlas, the vertex shader's key,
+// prim, count, instances, stride, the atlas texture's 20-bit ID and serial, the first 16 bytes of the bound vertex stream, and for every
+// uniform buffer that draw's vertex stage binds (up to 4): the guest address (the address the host hands the GPU: the binding is
+// mtl_gpu_addr(u->addr, 1, ...), a zero-copy view of guest memory), its size, the ring slot the address lies in (addr & ~0x7fffff), the
+// signed distance from the previous atlas draw's address for the same register (a per-frame ring moves by a constant; the same address
+// means the same slot), whether inline uniform updates deferred in this pass cover the binding (dh: the GPU then reads a shadow, not guest
+// memory), the first 256 bytes as 64 floats, and how many of its words are zero / NaN / Inf / denormal / |x| > 1e6. At the present the
+// same bytes are read again (`[ubds]` for the summary, `[ubdp]` for each block that changed), so "the guest wrote this block after the
+// draw that reads it was recorded" is measured rather than assumed. Off unless DM_NVN_UBDUMP names a file; at most DM_NVN_UBDUMP_N (12)
+// atlas draws a frame are kept, and the only cost when it is off is an is-it-on test in the draw and present paths, so the frame rate the
+// artifact rate depends on is not disturbed.
+#define UBD_DRAWS 16
+#define UBD_UB 4
+#define UBD_BYTES 256
+static int ubdv_fd = -2, ubdv_maxd = 12, ubdv_nd;
+static uint64_t ubdv_f = ~0ull, ubdv_pa[16], ubdv_ph[16]; static uint32_t ubdv_pq[16][4]; static int ubdv_pset[16], ubdv_nbad;
+static struct { uint64_t a, h; uint32_t n; uint8_t reg; } ubdv_rec[UBD_DRAWS * UBD_UB];
+static int ubdv_nr;
+static int ubdv_on(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("DM_NVN_UBDUMP"), *nn = getenv("DM_NVN_UBDUMP_N");
+        v = e && *e; if (nn && atoi(nn) > 0) ubdv_maxd = atoi(nn);
+        if (v) {
+            ubdv_fd = open(e, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND, 0644);
+            if (ubdv_fd < 0) { MLOG("[ubd] DM_NVN_UBDUMP: cannot open %s", e); v = 0; }
+            else MLOG("[ubd] DM_NVN_UBDUMP=%s: every atlas draw's vertex-stage uniform values (<= %d bytes each, <= %d draws a frame), re-read at the present", e, UBD_BYTES, ubdv_maxd);
+        }
+    }
+    return v;
+}
+static void ubdv_put(const char *b, int n) { if (ubdv_fd < 0 || n <= 0) return; ssize_t w = write(ubdv_fd, b, (size_t)n); (void)w; }
+static int ubdv_read(uint64_t a, uint32_t n, uint8_t *out) {   // the bytes as the GPU's own buffer holds them: 64 at a time, so a read that crosses a pool end keeps what it got
+    memset(out, 0, UBD_BYTES);
+    uint32_t got = 0;
+    while (got < n) {
+        uint32_t l = n - got; if (l > 64) l = 64;
+        void *mb; uint64_t mo;
+        if (!mtl_addr(a + got, l, &mb, &mo)) break;
+        const uint8_t *c = [(__bridge id<MTLBuffer>)mb contents]; if (!c) break;
+        memcpy(out + got, c + mo, l); got += l;
+    }
+    return (int)got;
+}
+// The bytes the GPU reads for this binding, by the same rule encode_args uses (nvn_mtl.m ~7138): when inline uniform updates are
+// deferred in this pass the GPU reads their shadow, not guest memory, so a dump of guest memory alone would report the wrong thing.
+// *src: 1 = the deferred updates, 2 = their partial shadow, 0 = guest memory. Returns the bytes obtained.
+static int ubdv_bytes(NvShader *sh, int reg, uint64_t a, uint32_t n, uint8_t *out, int *src) {
+    const p_bind_buf *u = &S.ubo[0][reg];
+    uint64_t ul = u ? cb_len(sh, reg, u->size) : 0;
+    *src = 0;
+    if (ul && g_nubd && ubd_hits(a, a + ul)) {
+        if (ubd_covers(a, a + ul)) { memset(out, 0, UBD_BYTES); ubd_read(a, n, out); *src = 1; return (int)n; }
+        uint64_t g; const uint8_t *c; if (ubp_get(a, a + ul, &g, &c) && c) { memcpy(out, c, n); *src = 2; return (int)n; }
+    }
+    return ubdv_read(a, n, out);
+}
+static uint64_t ubdv_fnv(const uint8_t *p, uint32_t n) { uint64_t h = 0xcbf29ce484222325ull; for (uint32_t i = 0; i < n; i++) { h ^= p[i]; h *= 0x100000001b3ull; } return h; }
+static void ubdv_fl(char *b, size_t cap, const uint8_t *p, uint32_t n) {   // the block as floats (%.9g round-trips a float exactly), so the transform fields can be read as numbers
+    size_t o = 0; uint32_t nf = n / 4; if (nf > UBD_BYTES / 4) nf = UBD_BYTES / 4;
+    if (!nf) { snprintf(b, cap, "-"); return; }
+    for (uint32_t i = 0; i < nf && o + 24 < cap; i++) { float f; memcpy(&f, p + 4 * i, 4); o += (size_t)snprintf(b + o, cap - o, i ? ",%.9g" : "%.9g", (double)f); }
+}
+static void ubdv_cnt(const uint8_t *p, uint32_t n, unsigned *zer, unsigned *nan, unsigned *inf, unsigned *den, unsigned *big) {
+    *zer = *nan = *inf = *den = *big = 0;
+    for (uint32_t i = 0; i + 4 <= n; i += 4) {
+        uint32_t w; memcpy(&w, p + i, 4); if (!w) { (*zer)++; continue; }
+        unsigned ex = (w >> 23) & 0xff; if (ex == 0xff) { if (w & 0x7fffff) (*nan)++; else (*inf)++; continue; }
+        if (!ex) { (*den)++; continue; }
+        float f; memcpy(&f, &w, 4); if (f > 1e6f || f < -1e6f) (*big)++;
+    }
+}
+// DM_NVN_UBDUMP_W=1 arms one write watch per page a "bad" uniform block lives in (dm_watch_dyn, dm/host/probe.c), so the guest code that
+// writes it can be named. Off by default: a watched page faults on every store, which is exactly the kind of perturbation a timing-sensitive
+// artifact must not see while its values are being measured.
+#define UBDV_W 2
+static struct { int id; uint64_t pg; } ubdv_w[UBDV_W] = {{-1, 0}, {-1, 0}};
+static int ubdv_w_on(void) { static int v = -1; if (v < 0) v = getenv("DM_NVN_UBDUMP_W") != NULL; return v; }
+static void ubdv_watch(uint64_t a, int reg, uint64_t f) {
+    if (!ubdv_w_on() || !dm_watch_dyn) return;
+    uint64_t pg = a & ~(uint64_t)0x3fff;
+    for (int i = 0; i < UBDV_W; i++) if (ubdv_w[i].id >= 0 && ubdv_w[i].pg == pg) return;
+    for (int i = 0; i < UBDV_W; i++) if (ubdv_w[i].id < 0) {
+        char tag[24]; snprintf(tag, sizeof tag, "ubo%llx", (unsigned long long)(pg >> 14));
+        ubdv_w[i].id = dm_watch_dyn(pg, 0x4000, tag); ubdv_w[i].pg = pg;
+        char b[256]; int n = snprintf(b, sizeof b, "[ubdw] f=%llu reg=%d a=%#llx arm pg=%#llx+0x4000 id=%d (every store into the page, to name the producer)\n",
+                                     (unsigned long long)f, reg, (unsigned long long)a, (unsigned long long)pg, ubdv_w[i].id);
+        ubdv_put(b, n); return; }
+}
+static void ubdv_draw(NvProg *pr, const p_draw *dw, const p_draw_idx *di) {
+    if (!ubdv_on()) return;
+    int ast = rt_atlas(pr); if (ast < 0) return;   // only the draws that sample the font atlas: a handful a frame
+    uint64_t f = atomic_load(&g_cur_frame);
+    if (f != ubdv_f) { ubdv_f = f; ubdv_nd = 0; ubdv_nr = 0; }
+    if (ubdv_nd >= ubdv_maxd) return;
+    ubdv_nd++;
+    int areg = -1, atid = 0; uint64_t aser = 0; NvShader *ash = pr->sh[ast];   // which atlas texture (slot, ID, serial) this draw samples
+    for (int i = 0; ash && i < ash->rf.nb; i++) {
+        const nvn_rbind *rb = &ash->rf.b[i];
+        if ((rb->kind != NVN_RB_TEX && rb->kind != NVN_RB_TBUF) || rb->reg >= NTEX) continue;
+        uint64_t hh = tex_slot_h(S.tex[ast], S.img[ast], rb->reg); int tid = (int)(hh & 0xfffff);
+        if (tid <= 0) continue;
+        void *tv = NULL; if (!tex_fast_rid(tid, &tv) || !tv) continue;
+        id<MTLTexture> t = (__bridge id<MTLTexture>)tv;
+        if (t && t.textureType == MTLTextureType2D && t.mipmapLevelCount <= 1 && t.pixelFormat == MTLPixelFormatR8Unorm &&
+            (uint64_t)t.width * t.height >= (2u << 20)) { areg = rb->reg; atid = tid; aser = h_ser(hh); break; }
+    }
+    char b[8192]; size_t o = 0;
+    #define UBD_ADD(...) do { if (o + 64 < sizeof b) o += (size_t)snprintf(b + o, sizeof b - o, __VA_ARGS__); } while (0)
+    uint8_t q[16]; int okq = vb_read(S.vbuf[0].address, sizeof q, q);
+    UBD_ADD("[ubd] %9.6f T=%04x f=%llu p=%llu np=%llu di=%d vs=%s fs=%s prim=%d count=%d inst=%d stride=%d vb0=%#llx vbw=%08x,%08x,%08x,%08x ast=%d areg=%d atid=%d aser=%016llx",
+            (double)(now_ns() - g_t0_ns) / 1e9, thr_cur_handle(), (unsigned long long)f, (unsigned long long)g_stat_pass,
+            (unsigned long long)atomic_load(&rt_np), ubdv_nd - 1,
+            pr->sh[0] && pr->sh[0]->key ? pr->sh[0]->key : "-", pr->sh[1] && pr->sh[1]->key ? pr->sh[1]->key : "-",
+            (int)(dw ? dw->prim : di->prim), (int)(dw ? dw->count : di->count), (int)(dw ? dw->instances : di->instances),
+            (int)S.stream[0].stride, (unsigned long long)S.vbuf[0].address,
+            okq ? *(const uint32_t *)(q + 0) : 0, okq ? *(const uint32_t *)(q + 4) : 0, okq ? *(const uint32_t *)(q + 8) : 0, okq ? *(const uint32_t *)(q + 12) : 0,
+            ast, areg, atid, (unsigned long long)aser);
+    int nu = 0; NvShader *v = pr->sh[0];
+    for (int i = 0; v && i < v->rf.nb && nu < UBD_UB; i++) {
+        const nvn_rbind *rb = &v->rf.b[i];
+        if (rb->kind != NVN_RB_CBUF || rb->reg >= 16) continue;   // the vertex stage's uniform buffers: what places the glyph quads
+        const p_bind_buf *u = &S.ubo[0][rb->reg];
+        if (!u->addr || !u->size) { UBD_ADD(" u%d[unbound]", rb->reg); nu++; continue; }
+        uint32_t len = u->size < UBD_BYTES ? (uint32_t)u->size : UBD_BYTES;
+        uint8_t p[UBD_BYTES]; int src = 0; int got = ubdv_bytes(v, rb->reg, u->addr, len, p, &src);
+        unsigned z, na, in, de, bg; ubdv_cnt(p, len, &z, &na, &in, &de, &bg);
+        char fl[1400]; ubdv_fl(fl, sizeof fl, p, (uint32_t)got);
+        uint64_t h = ubdv_fnv(p, (uint32_t)got);
+        float pq[4]; memcpy(pq, ubdv_pq[rb->reg], sizeof pq);
+        int same = ubdv_pset[rb->reg] && ubdv_ph[rb->reg] == h;   // the block still holds what the previous frame's draw read
+        int bad = na || in || bg;   // no finite value over 1e4 can be this frame's UI transform; the shader's own clamp turns it into a screen-sized or an off-screen quad
+        if (bad) ubdv_nbad++;
+        UBD_ADD(" u%d[a=%#llx sz=%#x slot=%#llx d=%lld got=%d src=%d same=%d bad=%d z=%u nan=%u inf=%u den=%u big=%u ph=%016llx p4=%.9g,%.9g,%.9g,%.9g fl=%s]",
+                rb->reg, (unsigned long long)u->addr, u->size, (unsigned long long)(u->addr & ~(uint64_t)0x7fffff),
+                (long long)(ubdv_pa[rb->reg] ? (long long)(u->addr - ubdv_pa[rb->reg]) : 0), got, src, same, bad, z, na, in, de, bg,
+                (unsigned long long)ubdv_ph[rb->reg], (double)pq[0], (double)pq[1], (double)pq[2], (double)pq[3], fl);
+        ubdv_ph[rb->reg] = h; memcpy(ubdv_pq[rb->reg], p, sizeof ubdv_pq[0]); ubdv_pset[rb->reg] = 1;
+        ubdv_pa[rb->reg] = u->addr;
+        if (ubdv_nr < UBD_DRAWS * UBD_UB) { ubdv_rec[ubdv_nr].a = u->addr; ubdv_rec[ubdv_nr].n = len; ubdv_rec[ubdv_nr].reg = (uint8_t)rb->reg; ubdv_rec[ubdv_nr].h = h; ubdv_nr++; }
+        if (bad || (f % 600) == 0) ubdv_watch(u->addr, rb->reg, f);   // DM_NVN_UBDUMP_W: who writes this page
+        nu++;
+    }
+    if (o > sizeof b - 2) o = sizeof b - 2;
+    b[o++] = '\n'; ubdv_put(b, (int)o);
+    #undef UBD_ADD
+}
+static void ubdv_present(void) {   // the same blocks, read again at the present: chg means the guest wrote them after the draw was recorded
+    if (!ubdv_on() || !ubdv_nr) return;
+    uint64_t f = atomic_load(&g_cur_frame);
+    if (f != ubdv_f) return;
+    char b[2000]; size_t o = 0; int chg = 0, unread = 0, checked = 0;
+    for (int i = 0; i < ubdv_nr; i++) {
+        uint8_t p[UBD_BYTES]; int got = ubdv_read(ubdv_rec[i].a, ubdv_rec[i].n, p);   // guest memory: the deferred list is empty by now (ubd_flush), so this is the final content
+        if (got != (int)ubdv_rec[i].n) { unread++; continue; }
+        checked++;
+        if (ubdv_fnv(p, (uint32_t)got) == ubdv_rec[i].h) continue;
+        chg++;
+        char fl[1400]; ubdv_fl(fl, sizeof fl, p, 64);
+        o = (size_t)snprintf(b, sizeof b, "[ubdp] f=%llu r=%d a=%#llx was=%016llx now=%016llx post=%s\n", (unsigned long long)f, ubdv_rec[i].reg,
+                             (unsigned long long)ubdv_rec[i].a, (unsigned long long)ubdv_rec[i].h, (unsigned long long)ubdv_fnv(p, (uint32_t)got), fl);
+        ubdv_put(b, (int)(o < sizeof b ? o : sizeof b - 1));
+    }
+    for (int i = 0; i < UBDV_W && ubdv_w_on(); i++) {   // DM_NVN_UBDUMP_W: this frame's stores into the watched pages, with the writer's guest pc
+        if (ubdv_w[i].id < 0 || !dm_watch_dyn_runs) continue;
+        uint64_t o2[8 * 6]; int nr = dm_watch_dyn_runs(ubdv_w[i].id, 6, o2);
+        for (int k = 0; k < nr; k++) { uint64_t *r = &o2[8 * k]; char pcs[96]; rt_addr(pcs, sizeof pcs, r[4]);
+            o = (size_t)snprintf(b, sizeof b, "[ubdw] f=%llu pg=%#llx ea=%#llx..%#llx bytes=%llu t0=%9.6f t1=%9.6f T=%04x pc=%s v0=%016llx\n",
+                                 (unsigned long long)f, (unsigned long long)ubdv_w[i].pg, (unsigned long long)r[0], (unsigned long long)r[1],
+                                 (unsigned long long)((r[1] - r[0]) / 16), (double)r[2] / 1e9, (double)r[3] / 1e9, (unsigned)r[6], pcs, (unsigned long long)r[5]);
+            ubdv_put(b, (int)(o < sizeof b ? o : sizeof b - 1)); }

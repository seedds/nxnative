+}
+static void srt_present(void) {   // the records of the frame just presented, on disk before the next one is encoded
+    if (srt_fd >= 0) srt_flush();
+}
 static void rt_draw(NvProg *pr, const p_draw *dw, const p_draw_idx *di) {   // the atlas-sampling draws: the UI glyph runs and the full-screen quad

From 091dffee6ac45766d9cdf9de6b713fc0b84e3eed Mon Sep 17 00:00:00 2001
From: thatSchloesser <sschloesser2@gmail.com>
Date: Tue, 17 Nov 2026 11:50:44 -0700
Subject: [PATCH 25/32] diag(nvn): DM_NVN_UVRING -- the unit-uv blit quad
 counted per frame (left uncommitted by the replay round; off unless set)

---
 dm/gfx/nvn/nvn_mtl.m | 173 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 173 insertions(+)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 27acb60..07f721e 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -10999,6 +10999,176 @@ static void ew_present(void) {   // what the armed windows saw this frame, then
         if (dm_watch_dyn_rearm) dm_watch_dyn_rearm(ew_w[i].id);
     }
 }
+// ---------------- DM_NVN_UVRING=<file>: the unit-uv blit quad, counted per frame, one line a second ----------------
+// The residual lattice (orch/emit, orch/pos) is ONE 4-vertex quad with uv = the unit square at offset 20 and |x| = 1,
+// appended into a text batch by nro0 0x6d9810 <- 0x6d9f64. Its 112 bytes are constant (186/186 detections), so the
+// whole class can be recognised by integer compares in the draw's own vertex stream: no block dump, no hash, no second
+// pass, no readback, no uniform read, no per-draw line. Cost when off: one static-int test per stride-28 draw. When on:
+// one vb_read of the stream and ~12 integer compares per 4 vertices, plus one binding scan per stride-28 draw to name
+// the texture. It counts the quad per frame and prints one line a second: the count, the guest frame, the draw's atlas
+// texture serial, the three stride-28 draws before it (serial, vertex / fragment key, count) and the batch's draw count.
+#define UVR_RING 4
+#define UVR_TEX  4
+static int uvr_fd = -2;
+static uint64_t uvr_t0, uvr_ta, uvr_last_f = ~0ull, uvr_cq, uvr_cql, uvr_cf;
+static uint32_t uvr_q, uvr_ql, uvr_qf, uvr_fr, uvr_fq;   // exact quads / loose-only quads this second, quads this frame, frames this second, frames with an exact quad
+static struct { uint64_t ser; char vs[24], fs[24]; int count, prim; } uvr_rg[UVR_RING]; static int uvr_rn;
+static struct { uint64_t f; int nq, quad, count, prim, span; uint32_t tint; uint64_t ser; char vs[24], fs[24];
+                int tw, th, has_sc, sc[4], tser, tw2, th2, tfmt, t0w, t0h;
+                struct { uint64_t ser; char vs[24]; int count; } pv[3]; int npv; } uvr_m; static int uvr_havem;
+static struct { uint64_t ser; uint32_t w, h, fmt; int n; } uvr_tx[UVR_TEX]; static int uvr_ntx, uvr_to;
+static struct { uint64_t f, ser; int count, prim; uint32_t tint; } uvr_ml; static int uvr_haveml;
+static int uvr_on(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("DM_NVN_UVRING");
+        v = e && *e;
+        if (v) {
+            uvr_fd = open(e, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND, 0644);
+            if (uvr_fd < 0) { MLOG("[uvr] DM_NVN_UVRING: cannot open %s", e); v = 0; }
+            else MLOG("[uvr] DM_NVN_UVRING=%s: a unit-uv quad in a 28-byte-stride draw's own stream (uv (0,0)(1,0)(1,1)(0,1) at offset 20, |x| == 1), counted per frame, one line a second", e);
+        }
+    }
+    return v;
+}
+static int uvr_quad(const uint8_t *v, int exact) {   // 4 vertices x 28 bytes; 1 == the lattice's own quad, 2 == only its uv
+    static const uint32_t U[4][2] = { {0, 0}, {0x3f800000u, 0}, {0x3f800000u, 0x3f800000u}, {0, 0x3f800000u} };
+    int uv = 1;
+    for (int i = 0; i < 4 && uv; i++) {   // the measured order exactly (186/186 detections); a rotation is NOT this quad
+        const uint8_t *p = v + (size_t)i * 28 + 20; uint32_t u, w;
+        memcpy(&u, p, 4); memcpy(&w, p + 4, 4);
+        if (u != U[i][0] || w != U[i][1]) uv = 0;
+    }
+    if (!uv) return 0;
+    for (int i = 0; i < 4; i++) { float x; memcpy(&x, v + (size_t)i * 28, 4); if (fabsf(fabsf(x) - 1.0f) > 1e-4f) return 0; }
+    if (!exact) return 2;   // the brief's signature: unit-uv + |x| == 1. Other full-screen quads reach it; only the y tells them apart
+    static const float Y[4] = { 0.4285714f, 0.4285714f, -1.0f, -1.0f };   // y = 1-2c at c = 2/7 (top edge 0.4286) and c = 1 (bottom -1)
+    for (int i = 0; i < 4; i++) { float y; memcpy(&y, v + (size_t)i * 28 + 4, 4); if (fabsf(y - Y[i]) > 2e-3f) return 2; }
+    return 1;
+}
+static uint64_t uvr_atlas_ser(NvProg *pr) {   // the serial of the font atlas this draw samples (rt_atlas's rule), 0 when none
+    for (int st = 0; st < 6 && pr; st++) {
+        NvShader *sh = pr->sh[st]; if (!sh) continue;
+        for (int i = 0; i < sh->rf.nb; i++) {
+            const nvn_rbind *b = &sh->rf.b[i]; int tid = 0;
+            if ((b->kind == NVN_RB_TEX || b->kind == NVN_RB_TBUF) && b->reg < NTEX) tid = (int)(tex_slot_h(S.tex[st], S.img[st], b->reg) & 0xfffff);
+            else if (b->kind == NVN_RB_TEXU) tid = ubo_tex_id(ubo_handle(st, b->reg, b->off));
+            else continue;
+            if (tid <= 0) continue;
+            void *tv = NULL; if (!tex_fast_rid(tid, &tv) || !tv) continue;
+            id<MTLTexture> t = (__bridge id<MTLTexture>)tv;
+            if (t && t.textureType == MTLTextureType2D && t.mipmapLevelCount <= 1 && t.pixelFormat == MTLPixelFormatR8Unorm &&
+                (uint64_t)t.width * t.height >= (2u << 20)) return (tid < g_ntreg && g_treg[tid].ok) ? g_treg[tid].t.serial : 0;
+        }
+    }
+    return 0;
+}
+static int uvr_tex_at(NvProg *pr, int st, int *tid) {   // the first texture binding of stage st, as the encode sees it
+    NvShader *sh = pr ? pr->sh[st] : nil; if (!sh) return 0;
+    for (int i = 0; i < sh->rf.nb; i++) {
+        const nvn_rbind *b = &sh->rf.b[i]; int t = 0;
+        if ((b->kind == NVN_RB_TEX || b->kind == NVN_RB_TBUF) && b->reg < NTEX) t = (int)(tex_slot_h(S.tex[st], S.img[st], b->reg) & 0xfffff);
+        else if (b->kind == NVN_RB_TEXU) t = ubo_tex_id(ubo_handle(st, b->reg, b->off));
+        else continue;
+        if (t > 0) { *tid = t; return 1; }
+    }
+    return 0;
+}
+static void uvr_tex_info(NvProg *pr, uint64_t *ser, uint32_t *w, uint32_t *h, uint32_t *fmt) {   // what the quad shows
+    *ser = 0; *w = *h = *fmt = 0; int tid = 0;
+    if (!uvr_tex_at(pr, 1, &tid) && !uvr_tex_at(pr, 0, &tid)) return;
+    *ser = (tid < g_ntreg && g_treg[tid].ok) ? g_treg[tid].t.serial : 0;
+    void *tv = NULL; if (!tex_fast_rid(tid, &tv) || !tv) return;
+    id<MTLTexture> t = (__bridge id<MTLTexture>)tv;
+    if (t) { *w = (uint32_t)t.width; *h = (uint32_t)t.height; *fmt = (uint32_t)t.pixelFormat; }
+}
+static void uvr_note_tex(uint64_t ser, uint32_t w, uint32_t h, uint32_t fmt) {   // per-second histogram of what the quad sampled
+    for (int i = 0; i < uvr_ntx; i++) if (uvr_tx[i].ser == ser && uvr_tx[i].w == w) { uvr_tx[i].n++; return; }
+    if (uvr_ntx < UVR_TEX) { uvr_tx[uvr_ntx].ser = ser; uvr_tx[uvr_ntx].w = w; uvr_tx[uvr_ntx].h = h; uvr_tx[uvr_ntx].fmt = fmt; uvr_tx[uvr_ntx].n = 1; uvr_ntx++; return; }
+    uvr_to++;
+}
+static void uvr_tick(void) {   // one line a second: the counts, the last quad's own draw, and its three neighbours
+    if (uvr_fd < 0) return;
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    uint64_t ns = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    if (!uvr_t0) { uvr_t0 = uvr_ta = ns; return; }
+    if (ns - uvr_t0 < 1000000000ull) return;
+    double el = (double)(ns - uvr_t0) / 1e9; uvr_t0 = ns;
+    char b[896]; int n = 0;
+    n += snprintf(b + n, sizeof b - n, "[uvr] T=%.1f q=%u ql=%u frames=%u fq=%u q100=%.2f qs=%.2f cum_q=%llu cum_ql=%llu cum_f=%llu f=%llu",
+                  (double)(ns - uvr_ta) / 1e9, uvr_q, uvr_ql, uvr_fr, uvr_fq, uvr_fr ? 100.0 * uvr_q / uvr_fr : 0.0,
+                  uvr_q / el, (unsigned long long)uvr_cq, (unsigned long long)uvr_cql, (unsigned long long)uvr_cf,
+                  (unsigned long long)atomic_load(&g_cur_frame));
+    if (uvr_havem) {
+        n += snprintf(b + n, sizeof b - n, " | last f=%llu nq=%d ser=%llx timg=%llx:%dx%d:f%x vs=%s fs=%s count=%d prim=%d quad=%d span=%u.%u tint=%08x tgt=%dx%d sc=%d:%d,%d,%d,%d | prev",
+                      (unsigned long long)uvr_m.f, uvr_m.nq, (unsigned long long)uvr_m.ser, (unsigned long long)uvr_m.tser,
+                      uvr_m.t0w, uvr_m.t0h, uvr_m.tfmt, uvr_m.vs, uvr_m.fs,
+                      uvr_m.count, uvr_m.prim, uvr_m.quad, uvr_m.span >> 16, uvr_m.span & 0xffff, uvr_m.tint,
+                      uvr_m.tw, uvr_m.th, uvr_m.has_sc, uvr_m.sc[0], uvr_m.sc[1], uvr_m.sc[2], uvr_m.sc[3]);
+        for (int i = 0; i < uvr_m.npv; i++)
+            n += snprintf(b + n, sizeof b - n, " %llx:%s:%d", (unsigned long long)uvr_m.pv[i].ser, uvr_m.pv[i].vs, uvr_m.pv[i].count);
+        if (!uvr_m.npv) n += snprintf(b + n, sizeof b - n, " none");
+    }
+    if (uvr_ntx || uvr_to) {   // what the quads sampled this second
+        n += snprintf(b + n, sizeof b - n, " | teximg");
+        for (int i = 0; i < uvr_ntx; i++)
+            n += snprintf(b + n, sizeof b - n, " %llx:%ux%u:f%x:%d", (unsigned long long)uvr_tx[i].ser, uvr_tx[i].w, uvr_tx[i].h, uvr_tx[i].fmt, uvr_tx[i].n);
+        if (uvr_to) n += snprintf(b + n, sizeof b - n, " other:%d", uvr_to);
+    }
+    if (uvr_haveml)
+        n += snprintf(b + n, sizeof b - n, " | loose f=%llu ser=%llx count=%d prim=%d tint=%08x",
+                      (unsigned long long)uvr_ml.f, (unsigned long long)uvr_ml.ser, uvr_ml.count, uvr_ml.prim, uvr_ml.tint);
+    b[n++] = '\n';
+    ssize_t w = write(uvr_fd, b, (size_t)n); (void)w;
+    uvr_q = uvr_ql = uvr_fr = uvr_fq = 0; uvr_ntx = uvr_to = 0;
+}
+static void uvr_draw(uint64_t a, int count, int prim, NvProg *pr) {   // the draw path, for every 28-byte-stride draw
+    if (uvr_fd < 0 || !a || count < 4) return;
+    if (count > PDX_CAP / 28) count = PDX_CAP / 28;
+    static uint8_t blk[PDX_CAP] __attribute__((aligned(16)));
+    if (!vb_read(a, (size_t)count * 28, blk)) return;
+    uint64_t ser = uvr_atlas_ser(pr);
+    const char *vsk = pr && pr->sh[0] && pr->sh[0]->key ? pr->sh[0]->key : "-";
+    const char *fsk = pr && pr->sh[1] && pr->sh[1]->key ? pr->sh[1]->key : "-";
+    for (int i = 0; i + 4 <= count; i += 4) {
+        const uint8_t *p = blk + (size_t)i * 28; int m = uvr_quad(p, 1);
+        if (!m) continue;
+        if (m == 2) {   // unit uv and |x| == 1 but not this rect: a different full-screen quad. Counted apart, never mixed in.
+            uvr_ql++; uvr_cql++; uvr_ml.f = atomic_load(&g_cur_frame); uvr_ml.ser = ser; uvr_ml.count = count;
+            uvr_ml.prim = prim; memcpy(&uvr_ml.tint, p, 4); uvr_haveml = 1; continue; }
+        uvr_q++; uvr_cq++; uvr_qf++;
+        uvr_m.quad = i / 4; uvr_m.count = count; uvr_m.prim = prim;
+        uvr_m.span = pdx_span(p, 4); memcpy(&uvr_m.tint, p + 12, 4);   // the colour word, not the position
+        uvr_m.ser = ser; strlcpy(uvr_m.vs, vsk, sizeof uvr_m.vs); strlcpy(uvr_m.fs, fsk, sizeof uvr_m.fs);
+        { uint64_t ts; uint32_t tw2, th2, tf; uvr_tex_info(pr, &ts, &tw2, &th2, &tf);   // what the quad shows
+          uvr_m.tser = (int)ts; uvr_m.t0w = (int)tw2; uvr_m.t0h = (int)th2; uvr_m.tfmt = (int)tf;
+          uvr_note_tex(ts, tw2, th2, tf); }
+        { NSUInteger w0 = 0, h0 = 0; rt_dims(&w0, &h0); uvr_m.tw2 = (int)w0; uvr_m.th2 = (int)h0; }   // the draw's target
+        uvr_m.tw = uvr_m.tw2; uvr_m.th = uvr_m.th2;
+        uvr_m.has_sc = R.has_sc; uvr_m.sc[0] = R.sc.x; uvr_m.sc[1] = R.sc.y; uvr_m.sc[2] = R.sc.w; uvr_m.sc[3] = R.sc.h;
+        uvr_m.npv = 0;
+        for (int k = 3; k >= 1; k--) {   // the three stride-28 draws before this one, oldest first
+            int j = (uvr_rn - k + UVR_RING * 2) % UVR_RING;
+            if (!uvr_rg[j].vs[0]) continue;
+            uvr_m.pv[uvr_m.npv].ser = uvr_rg[j].ser; uvr_m.pv[uvr_m.npv].count = uvr_rg[j].count;
+            strlcpy(uvr_m.pv[uvr_m.npv].vs, uvr_rg[j].vs, sizeof uvr_m.pv[0].vs); uvr_m.npv++;
+        }
+        uvr_havem = 1;
+    }
+    { int j = uvr_rn & (UVR_RING - 1);   // remember this draw for the next quad's neighbours
+      uvr_rg[j].ser = ser; uvr_rg[j].count = count; uvr_rg[j].prim = prim;
+      strlcpy(uvr_rg[j].vs, vsk, sizeof uvr_rg[j].vs); strlcpy(uvr_rg[j].fs, fsk, sizeof uvr_rg[j].fs);
+      uvr_rn = (uvr_rn + 1) & (UVR_RING - 1); }
+}
+static void uvr_present(void) {   // frame rollover at the present (so a frame with no UI draw still counts), then the tick
+    if (uvr_fd < 0) return;
+    uint64_t f = atomic_load(&g_cur_frame);
+    if (f != uvr_last_f) {
+        if (uvr_qf) { uvr_m.f = uvr_last_f; uvr_m.nq = (int)uvr_qf; }   // that frame's final count, for the next line
+        uvr_last_f = f; uvr_cf++; uvr_fr++; uvr_fq += uvr_qf != 0; uvr_qf = 0;
+    }
+    uvr_tick();
+}

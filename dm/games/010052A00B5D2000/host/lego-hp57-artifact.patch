 static _Atomic uint64_t g_sync_ns;
+// DM_NVN_SYNCLOG=1 (diagnostic, off by default): one line per guest nvnSyncWait with what it waited for. `fence` is the value in the
+// guest's NVNsync (the fence of the submit that created it), `newest` the host's most recent submit and `done` the value the GPU
+// has actually completed, both read before the wait: `newest - fence` is how far behind the guest waits, `done >= fence` means the
+// host answered without blocking at all. It changes no behaviour and takes no lock.
+static int synclog(void) { static int v = -1; if (v < 0) { const char *e = getenv("DM_NVN_SYNCLOG"); v = e && atoi(e) > 0; if (v) LOG("DM_NVN_SYNCLOG: one line per guest SyncWait (fence, newest, done, timeout, result)"); } return v; }
 NVN(nvnSyncWait, NVNsyncWaitResult, const NVNsync *s, uint64_t timeout) {
     const sync_t *o = (const sync_t *)s;

# Production iOS defaults for Pokemon Legends: Z-A 2.0.2.
# Documents/env.txt has priority over every value below.
DM_PRESENT_INTERVAL=game
DM_ZA_SKILL_LAYOUT=1
DM_DISPLAY_HZ=120
DM_PRESENT_HZ=120
DM_ZA_FPS_MODE=dynamic60
# Always expose the complete Switch controller surface, including L3/R3 and
# the D-pad, and keep touch controls usable beside a keyboard or controller.
DM_PAD_FORCE_FULL=1
DM_PAD_KEEP_TOUCH=1

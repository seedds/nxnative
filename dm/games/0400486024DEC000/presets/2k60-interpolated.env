# OOT v131072: 30 native + 30 MetalFX-generated frames/s target.
# Experimental interpolation. Requires a display detected as at least 120 Hz.
# Output resolution is distinct from internal scene resolution.
# No game, shader, save or machine paths belong in this file.
DM_WINDOW=1
DM_FULLSCREEN=1
DM_FPS_TARGET=30
DM_FPS_HOLD=off
DM_PRESENT_HZ=60
DM_PRESENT_FIFO=1
DM_PRESENT_LINK=0
DM_PRESENT_SNAP=2
DM_DRAWABLE_SIZE=2560x1440
DM_SCREEN_MATCH=0
DM_SCREEN_NATIVE=0
DM_DYNAMIC_RESOLUTION=0
DM_UPSCALER=metalfx
DM_UPSCALER_EXPERIMENTAL=1
DM_PRESENT_UPSCALE=metalfx
DM_OOT_INTERPOLATION_PREVIEW=3
DM_OOT_FRAMEGEN_ASYNC=1
DM_OOT_HDR=0
DM_OOT_HDR_OUTPUT_ALIAS=0

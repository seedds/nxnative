<Project Sdk="Microsoft.NET.Sdk">

  <!-- test_spirv_else_if.py's harness: the shader translator built from this tree's own sources (as
       goto_conditions/Conditions.csproj is), so the test checks the SpirvGenerator.cs of the change under test, not a
       prebuilt dmsh_xlate. It translates one synthetic sm86 pixel program with dmsh_xlate's flags and writes the
       normal-mode and debug-mode SPIR-V. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>ElseIf</AssemblyName>
    <RootNamespace>Ryujinx.Graphics.Shader</RootNamespace>
    <RyuProjects>$(MSBuildThisFileDirectory)../../../third_party/ryujinx/src</RyuProjects>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(RyuProjects)/Ryujinx.Graphics.Shader</RyuSrc>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(RyuSrc)/**/*.cs" Exclude="$(RyuSrc)/obj/**;$(RyuSrc)/bin/**" />
    <EmbeddedResource Include="$(RyuSrc)/CodeGen/Glsl/HelperFunctions/*.glsl"
                      LogicalName="Ryujinx.Graphics.Shader.CodeGen.Glsl.HelperFunctions.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RyuProjects)/Ryujinx.Common/Ryujinx.Common.csproj" />
    <ProjectReference Include="$(RyuProjects)/Spv.Generator/Spv.Generator.csproj" />
  </ItemGroup>

</Project>

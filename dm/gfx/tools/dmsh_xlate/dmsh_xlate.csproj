<!-- Switch shader → SPIR-V translation tool. It references the Ryujinx shader translator source kept in the repository (dm/third_party/ryujinx); -p:RyuSrc=<dir> points it at another copy. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../../third_party/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
  <!-- Embed source and build policy: dmsh_chain.py checks that this binary matches the repository. -->
  <ItemGroup>
    <EmbeddedResource Include="Program.cs" LogicalName="src0" />
    <EmbeddedResource Include="dmsh_xlate.csproj" LogicalName="src1" />
    <EmbeddedResource Include="../../../../Directory.Build.props" LogicalName="src2" />
    <EmbeddedResource Include="../../../../global.json" LogicalName="src3" />
    <EmbeddedResource Include="$(RyuSrc)/Directory.Build.props" LogicalName="src4" />
  </ItemGroup>
</Project>

	$(B)/t_clockwait
	$(B)/t_preempt
	$(B)/t_preempt --all-peers
	$(B)/t_pause
	$(B)/t_pause_stress --seconds 1
	$(B)/t_pctl
	$(B)/t_net_eventfd
	$(B)/t_sf
	$(B)/t_time
	$(B)/t_sync_wait
	$(B)/t_shared_font
	$(B)/t_system_event
	$(B)/t_vorbis
	$(B)/t_vorbis_divides
	$(B)/t_movie_vpx
	$(B)/t_codec_video
	$(B)/t_movie_avc
	$(B)/t_nv
	$(B)/t_vi_history $(QUIET)
	$(B)/t_nfc
	$(B)/t_motion
	$(B)/t_motion_apple
	$(B)/t_pad_apple
	$(B)/t_home_quit
	$(B)/t_home_quit_mac
	$(B)/t_ctrl_prompt
	$(B)/t_motion_pro
	$(B)/t_motion_pro_mac
	TMPDIR="$(abspath $(B))" $(B)/t_hid
	$(B)/t_pad_hid
	$(B)/t_pad_hid_mac
	$(B)/t_pad_pro
	$(B)/t_switch2
	$(B)/t_haptics
	$(B)/t_haptics_apple
	TMPDIR="$(abspath $(B))" $(B)/t_cheats $(QUIET)
	$(B)/t_nro
	$(B)/t_symbols
run: $(B)/t_nro
run: $(B)/t_sync_wait
$(B)/t_sync_wait: t_sync_wait.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_sync_wait.c t_condvar_stub.c
sync-wait: $(B)/t_sync_wait

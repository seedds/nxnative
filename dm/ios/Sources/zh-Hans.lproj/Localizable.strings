/* Simplified Chinese for the iOS launcher (Launcher.swift, LauncherRow.swift), its in-game menu (GameMenu.swift) and the Mac settings window (dm/mac/Launcher.swift).
   The key is the English text; dm/ios/tests/test_launcher_strings.py lists what is missing or no longer shown. */

/* The settings screen */
"Play" = "开始游戏";
"Version %@" = "版本 %@";
"Reset to tested defaults" = "恢复为测试过的默认设置";
"Brings back all settings this game was tested with." = "把所有设置恢复为这个游戏测试时用的值。";
"Memory available" = "可用内存";
"Set at launch" = "已在启动时设定";
"Set by an env file" = "已由 env 文件设定";

/* Cloud saves */
"Cloud saves" = "云存档";
"Off" = "关";
"Choose a folder in iCloud Drive…" = "选择 iCloud 云盘中的文件夹…";
"Choose a different folder…" = "换一个文件夹…";
"Saved. The game uses this folder when you press Play." = "已保存。按下“开始游戏”后，游戏会使用这个文件夹。";
"That folder could not be remembered — try a different one." = "无法记住这个文件夹，请换一个试试。";
"Turn off cloud saves" = "关闭云存档";
"Choose a folder in iCloud Drive, and the same one in the Mac app's Cloud saves. The save comes in when the game starts and goes out after each save; a save that is replaced is kept in save-backups." = "在 iCloud 云盘中选择一个文件夹，并在 Mac 版的“云存档”中选择同一个。游戏启动时读入那里的存档，每次存档后再存回去；被替换的存档会保留在 save-backups 中。";
"The folder you chose before is no longer readable (the app was signed differently). Please choose it again." = "之前选择的文件夹已无法读取（App 的签名变了），请重新选择。";

/* The in-game menu */
"More settings on the start screen" = "更多设置请在启动画面中调整";
"Controller layout" = "操控布局";
"Tap" = "触屏";
"Set in env.txt" = "已在 env.txt 中设定";
"%@, set in env.txt" = "%@，已在 env.txt 中设定";

/* The Mac settings window */
"Advanced settings" = "高级设置";
"Show this window at launch" = "启动时显示此窗口";
"Quit" = "退出";
"Quit %@" = "退出 %@";
"Close Window" = "关闭窗口";
"Choose a folder…" = "选择文件夹…";
"Turn off" = "关闭";
"Choose the iCloud Drive folder the iPhone app uses for this game. The save comes in when the game starts and goes out after each save; a save that is replaced is kept in the save's -backups folder." = "选择 iPhone 版这个游戏所用的 iCloud 云盘文件夹。游戏启动时读入那里的存档，每次存档后再存回去；被替换的存档会保留在存档旁的 -backups 文件夹中。";
"Use for Cloud Saves" = "用作云存档";
"The folder the iPhone app chose in its launcher's Cloud saves" = "iPhone 版在启动画面“云存档”中选择的文件夹";
"iCloud Drive" = "iCloud 云盘";


# The shader chain for the Vulkan target (dm/gfx/tools/dmsh_build_vk.py, docs/design/vulkan-backend.md section 2): docker/README.md has the commands.
# The .NET 10 SDK for the Vulkan translator (dm/gfx/tools/dmsh_xlate_vk, built with dotnet build), Python 3.12 for the build script and its tests, and the SPIR-V tools of
# dmsh_chain_vk.lock built from pinned source by docker/build_spirv_tools.sh (SPIRV-Tools' spirv-val, spirv-link, spirv-opt, spirv-dis and spirv-as, glslang's glslangValidator, and
# SPIRV-Cross for the analyses that read an MSL rendering of the Vulkan SPIR-V: integer inputs and outputs, c1 bounds, uniform read extents), the same build as the port's bundles
# carry. No Metal tools: nothing here builds a Metal library.

# The SPIR-V tools, in a stage of its own: only the programs and their licences reach the image (/opt/spirv-tools). The first three instructions are Dockerfile.build's, so a
# machine that has built that image takes its toolchain layer from the build cache instead of a second download. The script checks every download's SHA-256 and the version
# line each program prints (--check)
FROM ubuntu:24.04@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c AS spirv-tools
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends clang-18 lld-18 llvm-18 cmake ninja-build python3 git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-18 100 \
 && update-alternatives --install /usr/bin/cc cc /usr/bin/clang-18 100 \
 && update-alternatives --install /usr/bin/ld.lld ld.lld /usr/bin/ld.lld-18 100
COPY build_spirv_tools.sh /tmp/build_spirv_tools.sh
RUN sh /tmp/build_spirv_tools.sh --all --work /tmp/spirv linux /out --check \
 && rm -rf /tmp/spirv /tmp/build_spirv_tools.sh

# The .NET SDK 10.0.404 (runtime 10.0.15) on Ubuntu 24.04, pinned by the digest of its multi-architecture index (the image of 2026-11-10, the newest 10.0 patch on
# 2026-11-15). Runtime 10.0.14 and later fix GHSA-p3jp-9v83-76w9 (the Brotli decoder), which 10.0.402's runtime 10.0.13 had and the published tools carried.
# The translator targets net10.0 and is framework-dependent, as dmsh_xlate_bin is
FROM mcr.microsoft.com/dotnet/sdk:10.0.404-noble@sha256:fe0fd4e93bd2fbb47c883b7a6369e5c8d3db8bf01cdc5981f6ee35fbdf3ff4fb
ENV DEBIAN_FRONTEND=noninteractive DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
# Python 3.12 (and PyYAML, which reads the workflow files) from Ubuntu 24.04's archive; apt resolves them when the image is built, so the versions are printed. Not Ubuntu's
# spirv-tools and glslang-tools: the SPIR-V tools are the stage's above, the ones dmsh_chain_vk.lock records
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-yaml \
 && rm -rf /var/lib/apt/lists/* \
 && dpkg-query -W -f '${Package} ${Version}\n' python3 python3-yaml \
 && dotnet --version
# Native AOT, for the port's prebuilt tools (dm/tools/publish_port_tools.sh: nx_extract and dmsh_xlate_vk for linux-x64, so that a player packs without .NET): the ILCompiler
# package compiles the program to object code, which clang links (with binutils' ld and objcopy, which strips the symbols into a .dbg file). clang 18 from Ubuntu 24.04, as the
# build image has it; the layer is 382 MB (the image 1.93 GB). dotnet build and the chain's tests do not use it. Its own layer, so the layers above stay cached
RUN apt-get update \
 && apt-get install -y --no-install-recommends clang-18 \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-18 100 \
 && dpkg-query -W -f '${Package} ${Version}\n' clang-18 libllvm18 binutils libc6-dev \
 && clang --version | head -1
# What the packer itself imports (scripts/build_ipa_from_nsp.py --platform linux: check_prereqs_port), so that this image packs a game from its NSP folder: lz4 (the NSOs'
# segments) from Ubuntu 24.04's archive, and from PyPI, pinned: capstone (the rewriter's disassembly) and backports.zstd (Python 3.12 has no compression.zstd). capstone
# 5.0.9, the bundles' (dm/tools/publish_port_python.py), not Ubuntu's python3-capstone 4.0.2, which the rewriter refuses: it decodes no udf and rewrites a module differently
# (dm/tools/capstone_version.py; docs/reference/rewriter.md, "The capstone version"). No zstd program, on purpose: a player's PC need not have one, and the packer's tools read .zs files with the module there (shader_split.py unzs). The recompiler built in the nxnative-aot image runs here too (libLLVM-18 came with clang-18). Its own layer, so the layers above stay cached.
# fontTools (from PyPI, pinned: Ubuntu's python3-fonttools brings numpy and scipy, 370 MB) and DejaVu Sans for the pack's button-icon font (make_ext_font.py takes its
# letters from DejaVu Sans Bold, as on a desktop Linux)
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-lz4 fonts-dejavu-core python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --break-system-packages --no-cache-dir capstone==5.0.9 backports.zstd==1.7.0 fonttools==4.68.0 \
 && dpkg-query -W -f '${Package} ${Version}\n' python3-lz4 fonts-dejavu-core \
 && python3 -c "import lz4.block, capstone, backports.zstd, fontTools, importlib.metadata as m; print('lz4', lz4.__version__, 'capstone', m.version('capstone'), 'fontTools', fontTools.version)"
COPY --from=spirv-tools /out/ /opt/spirv-tools/
ENV PATH=/opt/spirv-tools:$PATH
# The worktree is mounted at /src and the container runs as the caller's user (HOME=/tmp): git refuses a repository owned by another user without this
RUN git config --system --add safe.directory '*' && spirv-cross --revision && spirv-val --version | head -1 && glslangValidator --version | head -1
WORKDIR /src
